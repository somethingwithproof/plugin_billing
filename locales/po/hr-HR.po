msgid "Three-letter uppercase ISO 4217 currency code for new accounts and contracts."
msgstr "Troslovna ISO 4217 oznaka valute pisana velikim slovima za nove račune i ugovore."

#: lib/Settings.php
msgid "Counter Spike Cap Multiplier"
msgstr "Množitelj ograničenja skokova brojača"

#: lib/Settings.php
msgid "Maximum bps multiple of interface port speed before clamping counter spikes."
msgstr "Najveći višekratnik brzine priključka sučelja u bps prije ograničavanja skokova brojača."

#: lib/Settings.php
msgid "Security, ERP Webhooks, and Retention"
msgstr "Sigurnost, ERP webhookovi i zadržavanje podataka"

#: lib/Settings.php
msgid "Outbound Webhook Timeout (seconds)"
msgstr "Vremensko ograničenje odlaznog webhooka (sekunde)"

#: lib/Settings.php
msgid "Bounded HTTPS timeout for ERP billing connector deliveries (1 to 60s)."
msgstr "Ograničeno HTTPS vremensko ograničenje za isporuke ERP konektora za naplatu (od 1 do 60 s)."

#: lib/Settings.php
msgid "Maximum Webhook Response Bytes"
msgstr "Maksimalan broj bajtova odgovora webhooka"

#: lib/Settings.php
msgid "Upper bound on bytes read from ERP webhook responses."
msgstr "Gornja granica bajtova koji se čitaju iz odgovora ERP webhooka."

#: lib/Settings.php
msgid "AES-256-GCM External Keyfile Path"
msgstr "Putanja vanjske AES-256-GCM datoteke ključa"

#: lib/Settings.php
msgid "Absolute filesystem path to the external 256-bit keyfile protecting ERP connector secrets."
msgstr "Apsolutna putanja u datotečnom sustavu do vanjske 256-bitne datoteke ključa koja štiti tajne ERP konektora."

#: lib/Settings.php
msgid "Burst Budget Warning Threshold (%)"
msgstr "Prag upozorenja kvote vršnog prekoračenja (%)"

#: lib/Settings.php
msgid "Percentage of monthly burst slots consumed before raising a warning forecast."
msgstr "Postotak potrošenih mjesečnih termina vršnog prekoračenja prije izdavanja prognoze upozorenja."

#: lib/Settings.php
msgid "Burst Budget Critical Threshold (%)"
msgstr "Kritični prag kvote vršnog prekoračenja (%)"

#: lib/Settings.php
msgid "Percentage of monthly burst slots consumed before raising a critical forecast."
msgstr "Postotak potrošenih mjesečnih termina vršnog prekoračenja prije izdavanja kritične prognoze."

#: lib/Settings.php
msgid "Preserve Ledger Tables on Uninstall"
msgstr "Zadrži knjigovodstvene tablice pri deinstalaciji"

#: lib/Settings.php
msgid "Keep plugin_billing_* tables (including immutable samples and statements) when uninstalling."
msgstr "Zadrži tablice plugin_billing_* (uključujući nepromjenjive uzorke i obračune) pri deinstalaciji."

