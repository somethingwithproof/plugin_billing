{
  "name": "somethingwithproof/plugin-billing",
  "description": "Carrier-grade Cacti 1.2 95th-percentile burstable transit and usage billing plugin with immutable ledger, SHA-256 dispute proof, and ISP ERP bridges",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.2",
    "ext-json": "*",
    "ext-openssl": "*"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "Somethingwithproof\\Billing\\": "lib/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Somethingwithproof\\Billing\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit -c phpunit.xml",
    "test:integration": "phpunit -c phpunit-integration.xml",
    "phpstan": "phpstan analyse -c phpstan.neon --memory-limit=1G --no-progress"
  },
  "config": {
    "sort-packages": true
  }
}
