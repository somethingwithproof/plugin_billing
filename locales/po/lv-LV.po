#: lib/Settings.php
msgid "Rating & 95th-Percentile Defaults"
msgstr "Tarifikācijas un 95. procentiles noklusējuma iestatījumi"

#: lib/Settings.php
msgid "Default Percentile"
msgstr "Noklusējuma procentile"

#: lib/Settings.php
msgid "Default Nth percentile applied to new burstable contracts (50.0 to 100.0)."
msgstr "Noklusējuma N-tā procentile, ko piemēro jauniem mainīgas jaudas līgumiem (no 50.0 līdz 100.0)."

#: lib/Settings.php
msgid "Default Drop-Count Rounding"
msgstr "Noklusējuma izslēdzamo intervālu skaita noapaļošana"

#: lib/Settings.php
msgid "Rounding mode for peak intervals dropped when computing the Nth percentile."
msgstr "Noapaļošanas režīms pīķa intervāliem, kas tiek izslēgti, aprēķinot N-to procentili."

#: lib/Settings.php
msgid "Floor"
msgstr "Uz leju"

#: lib/Settings.php
msgid "Ceiling"
msgstr "Uz augšu"

#: lib/Settings.php
msgid "Nearest"
msgstr "Līdz tuvākajam"

#: lib/Settings.php
msgid "Default Missing-Sample Policy"
msgstr "Noklusējuma trūkstošo mērījumu politika"

#: lib/Settings.php
msgid "How missing 5-minute intervals are treated during rating."
msgstr "Kā tarifikācijas laikā apstrādāt trūkstošos 5 minūšu intervālus."

#: lib/Settings.php
msgid "Exclude gaps"
msgstr "Izslēgt iztrūkumus"

#: lib/Settings.php
msgid "Zero-fill missing slots"
msgstr "Aizpildīt trūkstošos intervālus ar nullēm"

#: lib/Settings.php
msgid "Carry forward previous sample"
msgstr "Pārnest iepriekšējo mērījumu"

#: lib/Settings.php
msgid "Default ISO 4217 Currency"
msgstr "Noklusējuma ISO 4217 valūta"

#: lib/Settings.php
msgid "Three-letter uppercase ISO 4217 currency code for new accounts and contracts."
msgstr "Trīs lielo burtu ISO 4217 valūtas kods jauniem kontiem un līgumiem."

#: lib/Settings.php
msgid "Counter Spike Cap Multiplier"
msgstr "Skaitītāja lēcienu ierobežošanas reizinātājs"

#: lib/Settings.php
msgid "Maximum bps multiple of interface port speed before clamping counter spikes."
msgstr "Maksimālais saskarnes porta ātruma reizinātājs (bps), pirms tiek ierobežoti skaitītāja lēcieni."

#: lib/Settings.php
msgid "Security, ERP Webhooks, and Retention"
msgstr "Drošība, ERP tīmekļa āķi un glabāšana"

#: lib/Settings.php
msgid "Outbound Webhook Timeout (seconds)"
msgstr "Izejošā tīmekļa āķa noildze (sekundēs)"

#: lib/Settings.php
msgid "Bounded HTTPS timeout for ERP billing connector deliveries (1 to 60s)."
msgstr "Ierobežota HTTPS noildze ERP norēķinu savienotāja piegādēm (no 1 līdz 60 s)."

#: lib/Settings.php
msgid "Maximum Webhook Response Bytes"
msgstr "Maks. tīmekļa āķa atbildes lielums baitos"

#: lib/Settings.php
msgid "Upper bound on bytes read from ERP webhook responses."
msgstr "Augšējā robeža baitu skaitam, kas tiek nolasīts no ERP tīmekļa āķu atbildēm."

#: lib/Settings.php
msgid "AES-256-GCM External Keyfile Path"
msgstr "AES-256-GCM ārējās atslēgas datnes ceļš"

#: lib/Settings.php
msgid "Absolute filesystem path to the external 256-bit keyfile protecting ERP connector secrets."
msgstr "Absolūtais datņu sistēmas ceļš līdz ārējai 256 bitu atslēgas datnei, kas aizsargā ERP savienotāja noslēpumus."

#: lib/Settings.php
msgid "Burst Budget Warning Threshold (%)"
msgstr "Pīķa slodzes budžeta brīdinājuma slieksnis (%)"

#: lib/Settings.php
msgid "Percentage of monthly burst slots consumed before raising a warning forecast."
msgstr "Ikmēneša pīķa slodzes intervālu procentuālā daļa, pēc kuras izlietošanas tiek izveidota brīdinājuma prognoze."

#: lib/Settings.php
msgid "Burst Budget Critical Threshold (%)"
msgstr "Pīķa slodzes budžeta kritiskais slieksnis (%)"

#: lib/Settings.php
msgid "Percentage of monthly burst slots consumed before raising a critical forecast."
msgstr "Ikmēneša pīķa slodzes intervālu procentuālā daļa, pēc kuras izlietošanas tiek izveidota kritiska prognoze."

#: lib/Settings.php
msgid "Preserve Ledger Tables on Uninstall"
msgstr "Saglabāt uzskaites tabulas atinstalēšanas laikā"

#: lib/Settings.php
msgid "Keep plugin_billing_* tables (including immutable samples and statements) when uninstalling."
msgstr "Atinstalējot saglabāt plugin_billing_* tabulas (ieskaitot nemaināmos mērījumus un pārskatus)."

