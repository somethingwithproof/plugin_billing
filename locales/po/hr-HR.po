msgid "Default Nth percentile applied to new burstable contracts (50.0 to 100.0)."
msgstr "Zadani N-ti percentil koji se primjenjuje na nove ugovore s vršnim prekoračenjem (od 50.0 do 100.0)."

#: lib/Settings.php
msgid "Default Drop-Count Rounding"
msgstr "Zadano zaokruživanje broja odbačenih uzoraka"

