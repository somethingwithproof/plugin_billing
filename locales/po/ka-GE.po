msgid "Maximum bps multiple of interface port speed before clamping counter spikes."
msgstr "ინტერფეისის პორტის სიჩქარის მაქსიმალური bps ჯერადი მრიცხველის ნახტომების შეზღუდვამდე."

#: lib/Settings.php
msgid "Security, ERP Webhooks, and Retention"
msgstr "უსაფრთხოება, ERP ვებჰუკები და შენახვის ვადა"

#: lib/Settings.php
msgid "Outbound Webhook Timeout (seconds)"
msgstr "გამავალი ვებჰუკის მოლოდინის ვადა (წამებში)"

#: lib/Settings.php
msgid "Bounded HTTPS timeout for ERP billing connector deliveries (1 to 60s)."
msgstr "შეზღუდული HTTPS მოლოდინის ვადა ERP ბილინგის კონექტორის მიწოდებისთვის (1-დან 60 წმ-მდე)."

#: lib/Settings.php
msgid "Maximum Webhook Response Bytes"
msgstr "ვებჰუკის პასუხის მაქსიმალური ბაიტები"

#: lib/Settings.php
msgid "Upper bound on bytes read from ERP webhook responses."
msgstr "ERP ვებჰუკის პასუხებიდან წაკითხული ბაიტების ზედა ზღვარი."

#: lib/Settings.php
msgid "AES-256-GCM External Keyfile Path"
msgstr "AES-256-GCM გარე გასაღების ფაილის გზა"

#: lib/Settings.php
msgid "Absolute filesystem path to the external 256-bit keyfile protecting ERP connector secrets."
msgstr "ფაილური სისტემის აბსოლუტური გზა გარე 256-ბიტიან გასაღების ფაილამდე, რომელიც იცავს ERP კონექტორის საიდუმლოებებს."

#: lib/Settings.php
msgid "Burst Budget Warning Threshold (%)"
msgstr "პიკური ბიუჯეტის გაფრთხილების ზღვარი (%)"

#: lib/Settings.php
msgid "Percentage of monthly burst slots consumed before raising a warning forecast."
msgstr "ყოველთვიური პიკური სლოტების დახარჯვის პროცენტი გაფრთხილების პროგნოზის გამოტანამდე."

#: lib/Settings.php
msgid "Burst Budget Critical Threshold (%)"
msgstr "პიკური ბიუჯეტის კრიტიკული ზღვარი (%)"

#: lib/Settings.php
msgid "Percentage of monthly burst slots consumed before raising a critical forecast."
msgstr "ყოველთვიური პიკური სლოტების დახარჯვის პროცენტი კრიტიკული პროგნოზის გამოტანამდე."

#: lib/Settings.php
msgid "Preserve Ledger Tables on Uninstall"
msgstr "რეესტრის ცხრილების შენახვა დეინსტალაციისას"

#: lib/Settings.php
msgid "Keep plugin_billing_* tables (including immutable samples and statements) when uninstalling."
msgstr "plugin_billing_* ცხრილების (მათ შორის უცვლელი ნიმუშებისა და ამონაწერების) შენახვა დეინსტალაციისას."

