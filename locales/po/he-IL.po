msgstr "ספק תאריכי התחלה וסיום חוקיים לפי UTC."

#: billing_operator.php
#, php-format
msgid "Dry-run rating for %s: %s %s"
msgstr "תמחור ניסיוני עבור %s: %s %s"

#: billing_operator.php
msgid "Statement not found."
msgstr "דוח החיוב לא נמצא."

#: billing_operator.php
msgid "Unsupported operator action."
msgstr "פעולת מפעיל אינה נתמכת."

#: billing_operator.php
msgid "Billing Statement Audit, Proof Verification & Exports (Operator)"
msgstr "ביקורת דוחות חיוב, אימות הוכחות וייצוא (מפעיל)"

#: billing_view.php
msgid "Billing Usage & Mid-Cycle Burst Forecasts"
msgstr "שימוש בחיוב ותחזיות חריגת תעבורה באמצע מחזור"

#: lib/Pages.php
msgid "Billing View"
msgstr "צפייה בחיוב"

#: lib/Pages.php
msgid "Billing Operator"
msgstr "מפעיל חיוב"

#: lib/Pages.php
msgid "Billing Admin"
msgstr "מנהל חיוב"

#: lib/Pages.php
msgid "Billing Usage & Forecasts"
msgstr "שימוש בחיוב ותחזיות"

#: lib/Pages.php
msgid "Billing Statements & Audit"
msgstr "דוחות חיוב וביקורת"

#: lib/Pages.php
msgid "Billing Accounts & Tariffs"
msgstr "חשבונות חיוב ותעריפים"

#: lib/Settings.php
msgid "Rating & 95th-Percentile Defaults"
msgstr "ברירות מחדל לתמחור ולאחוזון ה-95"

#: lib/Settings.php
msgid "Default Percentile"
msgstr "אחוזון ברירת מחדל"

#: lib/Settings.php
msgid "Default Nth percentile applied to new burstable contracts (50.0 to 100.0)."
msgstr "אחוזון ברירת המחדל המוחל על חוזי תעבורה עם חריגה חדשים (50.0 עד 100.0)."

#: lib/Settings.php
msgid "Default Drop-Count Rounding"
msgstr "עיגול ברירת מחדל לספירת דגימות מוסרות"

#: lib/Settings.php
msgid "Rounding mode for peak intervals dropped when computing the Nth percentile."
msgstr "שיטת העיגול עבור מרווחי שיא המוסרים בעת חישוב האחוזון."

#: lib/Settings.php
msgid "Floor"
msgstr "עיגול כלפי מטה"

#: lib/Settings.php
msgid "Ceiling"
msgstr "עיגול כלפי מעלה"

#: lib/Settings.php
msgid "Nearest"
msgstr "הקרוב ביותר"

#: lib/Settings.php
msgid "Default Missing-Sample Policy"
msgstr "מדיניות ברירת מחדל לדגימות חסרות"

#: lib/Settings.php
msgid "How missing 5-minute intervals are treated during rating."
msgstr "אופן הטיפול במרווחים חסרים של 5 דקות במהלך התמחור."

#: lib/Settings.php
msgid "Exclude gaps"
msgstr "השמט פערים"

#: lib/Settings.php
msgid "Zero-fill missing slots"
msgstr "מלא משבצות חסרות באפס"

#: lib/Settings.php
msgid "Carry forward previous sample"
msgstr "המשך עם הדגימה הקודמת"

#: lib/Settings.php
msgid "Default ISO 4217 Currency"
msgstr "מטבע ISO 4217 כברירת מחדל"

#: lib/Settings.php
msgid "Three-letter uppercase ISO 4217 currency code for new accounts and contracts."
msgstr "קוד מטבע ISO 4217 בן שלוש אותיות גדולות עבור חשבונות וחוזים חדשים."

#: lib/Settings.php
msgid "Counter Spike Cap Multiplier"
msgstr "מכפיל חסימת קפיצות מונה"

#: lib/Settings.php
msgid "Maximum bps multiple of interface port speed before clamping counter spikes."
msgstr "מכפלה מרבית של מהירות פורט הממשק ב-bps לפני הגבלת קפיצות מונה."

#: lib/Settings.php
msgid "Security, ERP Webhooks, and Retention"
msgstr "אבטחה, קריאות Webhook של ERP ושמירת נתונים"

#: lib/Settings.php
msgid "Outbound Webhook Timeout (seconds)"
msgstr "זמן קצוב לקריאת Webhook יוצאת (שניות)"

#: lib/Settings.php
msgid "Bounded HTTPS timeout for ERP billing connector deliveries (1 to 60s)."
msgstr "זמן קצוב מוגבל של HTTPS למשלוחי מחבר חיוב ERP (1 עד 60 שניות)."

#: lib/Settings.php
msgid "Maximum Webhook Response Bytes"
msgstr "מספר בתים מרבי לתגובת Webhook"

#: lib/Settings.php
msgid "Upper bound on bytes read from ERP webhook responses."
msgstr "גבול עליון למספר הבתים הנקראים מתגובות Webhook של ERP."

#: lib/Settings.php
msgid "AES-256-GCM External Keyfile Path"
msgstr "נתיב לקובץ מפתח חיצוני AES-256-GCM"

#: lib/Settings.php
msgid "Absolute filesystem path to the external 256-bit keyfile protecting ERP connector secrets."
msgstr "נתיב מוחלט במערכת הקבצים לקובץ המפתח החיצוני של 256 סיביות המגן על סודות מחבר ה-ERP."

#: lib/Settings.php
msgid "Burst Budget Warning Threshold (%)"
msgstr "סף אזהרה לתקציב חריגה (%)"

#: lib/Settings.php
msgid "Percentage of monthly burst slots consumed before raising a warning forecast."
msgstr "אחוז משבצות החריגה החודשיות שנוצלו לפני הפקת תחזית אזהרה."

#: lib/Settings.php
msgid "Burst Budget Critical Threshold (%)"
msgstr "סף קריטי לתקציב חריגה (%)"

#: lib/Settings.php
msgid "Percentage of monthly burst slots consumed before raising a critical forecast."
msgstr "אחוז משבצות החריגה החודשיות שנוצלו לפני הפקת תחזית קריטית."

#: lib/Settings.php
msgid "Preserve Ledger Tables on Uninstall"
msgstr "שמור טבלאות יומן חשבונאי בעת הסרת ההתקנה"

#: lib/Settings.php
msgid "Keep plugin_billing_* tables (including immutable samples and statements) when uninstalling."
msgstr "שמור את הטבלאות plugin_billing_* (כולל דגימות ודוחות חיוב בלתי ניתנים לשינוי) בעת הסרת ההתקנה."

