#: lib/Settings.php
msgid "Rating & 95th-Percentile Defaults"
msgstr "Predefinições de tarifação e percentil 95"

#: lib/Settings.php
msgid "Default Percentile"
msgstr "Percentil predefinido"

#: lib/Settings.php
msgid "Default Nth percentile applied to new burstable contracts (50.0 to 100.0)."
msgstr "Enésimo percentil predefinido aplicado a novos contratos com tráfego de pico (50.0 a 100.0)."

#: lib/Settings.php
msgid "Default Drop-Count Rounding"
msgstr "Arredondamento predefinido de intervalos descartados"

#: lib/Settings.php
msgid "Rounding mode for peak intervals dropped when computing the Nth percentile."
msgstr "Modo de arredondamento para intervalos de pico descartados ao calcular o enésimo percentil."

#: lib/Settings.php
msgid "Floor"
msgstr "Por defeito"

#: lib/Settings.php
msgid "Ceiling"
msgstr "Por excesso"

#: lib/Settings.php
msgid "Nearest"
msgstr "Mais próximo"

#: lib/Settings.php
msgid "Default Missing-Sample Policy"
msgstr "Política predefinida para amostras em falta"

#: lib/Settings.php
msgid "How missing 5-minute intervals are treated during rating."
msgstr "Como os intervalos de 5 minutos em falta são tratados durante a tarifação."

#: lib/Settings.php
msgid "Exclude gaps"
msgstr "Excluir lacunas"

#: lib/Settings.php
msgid "Zero-fill missing slots"
msgstr "Preencher intervalos em falta com zeros"

#: lib/Settings.php
msgid "Carry forward previous sample"
msgstr "Transportar amostra anterior"

#: lib/Settings.php
msgid "Default ISO 4217 Currency"
msgstr "Moeda ISO 4217 predefinida"

#: lib/Settings.php
msgid "Three-letter uppercase ISO 4217 currency code for new accounts and contracts."
msgstr "Código de moeda ISO 4217 de três letras maiúsculas para novas contas e contratos."

#: lib/Settings.php
msgid "Counter Spike Cap Multiplier"
msgstr "Multiplicador limite de picos de contador"

#: lib/Settings.php
msgid "Maximum bps multiple of interface port speed before clamping counter spikes."
msgstr "Múltiplo máximo em bps da velocidade da porta da interface antes de limitar picos de contador."

#: lib/Settings.php
msgid "Security, ERP Webhooks, and Retention"
msgstr "Segurança, webhooks ERP e retenção"

#: lib/Settings.php
msgid "Outbound Webhook Timeout (seconds)"
msgstr "Tempo limite de webhook de saída (segundos)"

#: lib/Settings.php
msgid "Bounded HTTPS timeout for ERP billing connector deliveries (1 to 60s)."
msgstr "Tempo limite HTTPS limitado para entregas de conectores de faturação ERP (1 a 60 s)."

#: lib/Settings.php
msgid "Maximum Webhook Response Bytes"
msgstr "Máximo de bytes de resposta de webhook"

#: lib/Settings.php
msgid "Upper bound on bytes read from ERP webhook responses."
msgstr "Limite máximo de bytes lidos a partir de respostas de webhooks ERP."

#: lib/Settings.php
msgid "AES-256-GCM External Keyfile Path"
msgstr "Caminho do ficheiro de chave externo AES-256-GCM"

#: lib/Settings.php
msgid "Absolute filesystem path to the external 256-bit keyfile protecting ERP connector secrets."
msgstr "Caminho absoluto no sistema de ficheiros para o ficheiro de chave externo de 256 bits que protege os segredos dos conectores ERP."

#: lib/Settings.php
msgid "Burst Budget Warning Threshold (%)"
msgstr "Limiar de aviso do orçamento de picos (%)"

#: lib/Settings.php
msgid "Percentage of monthly burst slots consumed before raising a warning forecast."
msgstr "Percentagem de intervalos mensais de pico consumidos antes de emitir uma previsão de aviso."

#: lib/Settings.php
msgid "Burst Budget Critical Threshold (%)"
msgstr "Limiar crítico do orçamento de picos (%)"

#: lib/Settings.php
msgid "Percentage of monthly burst slots consumed before raising a critical forecast."
msgstr "Percentagem de intervalos mensais de pico consumidos antes de emitir uma previsão crítica."

#: lib/Settings.php
msgid "Preserve Ledger Tables on Uninstall"
msgstr "Preservar tabelas de registo contabilístico ao desinstalar"

#: lib/Settings.php
msgid "Keep plugin_billing_* tables (including immutable samples and statements) when uninstalling."
msgstr "Manter as tabelas plugin_billing_* (incluindo amostras e extratos imutáveis) ao desinstalar."

