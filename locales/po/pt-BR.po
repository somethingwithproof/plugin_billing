#: lib/Settings.php
msgid "Rating & 95th-Percentile Defaults"
msgstr "Padrões de tarifação e percentil 95"

#: lib/Settings.php
msgid "Default Percentile"
msgstr "Percentil padrão"

#: lib/Settings.php
msgid "Default Nth percentile applied to new burstable contracts (50.0 to 100.0)."
msgstr "Enésimo percentil padrão aplicado a novos contratos com banda elástica (50.0 a 100.0)."

#: lib/Settings.php
msgid "Default Drop-Count Rounding"
msgstr "Arredondamento padrão da contagem de descartes"

#: lib/Settings.php
msgid "Rounding mode for peak intervals dropped when computing the Nth percentile."
msgstr "Modo de arredondamento para intervalos de pico descartados ao calcular o enésimo percentil."

#: lib/Settings.php
msgid "Floor"
msgstr "Para baixo (piso)"

#: lib/Settings.php
msgid "Ceiling"
msgstr "Para cima (teto)"

#: lib/Settings.php
msgid "Nearest"
msgstr "Mais próximo"

#: lib/Settings.php
msgid "Default Missing-Sample Policy"
msgstr "Política padrão para amostras ausentes"

#: lib/Settings.php
msgid "How missing 5-minute intervals are treated during rating."
msgstr "Como intervalos ausentes de 5 minutos são tratados durante a tarifação."

#: lib/Settings.php
msgid "Exclude gaps"
msgstr "Excluir lacunas"

#: lib/Settings.php
msgid "Zero-fill missing slots"
msgstr "Preencher intervalos ausentes com zero"

#: lib/Settings.php
msgid "Carry forward previous sample"
msgstr "Repetir a amostra anterior"

#: lib/Settings.php
msgid "Default ISO 4217 Currency"
msgstr "Moeda padrão ISO 4217"

#: lib/Settings.php
msgid "Three-letter uppercase ISO 4217 currency code for new accounts and contracts."
msgstr "Código de moeda ISO 4217 de três letras maiúsculas para novas contas e contratos."

#: lib/Settings.php
msgid "Counter Spike Cap Multiplier"
msgstr "Multiplicador limite para picos de contador"

#: lib/Settings.php
msgid "Maximum bps multiple of interface port speed before clamping counter spikes."
msgstr "Múltiplo máximo em bps da velocidade da porta da interface antes de limitar picos de contador."

#: lib/Settings.php
msgid "Security, ERP Webhooks, and Retention"
msgstr "Segurança, webhooks ERP e retenção"

#: lib/Settings.php
msgid "Outbound Webhook Timeout (seconds)"
msgstr "Tempo limite de webhook de saída (segundos)"

#: lib/Settings.php
msgid "Bounded HTTPS timeout for ERP billing connector deliveries (1 to 60s)."
msgstr "Tempo limite HTTPS limitado para entregas do conector ERP de faturamento (1 a 60s)."

#: lib/Settings.php
msgid "Maximum Webhook Response Bytes"
msgstr "Máximo de bytes na resposta do webhook"

#: lib/Settings.php
msgid "Upper bound on bytes read from ERP webhook responses."
msgstr "Limite máximo de bytes lidos das respostas de webhooks ERP."

#: lib/Settings.php
msgid "AES-256-GCM External Keyfile Path"
msgstr "Caminho do arquivo de chave externo AES-256-GCM"

#: lib/Settings.php
msgid "Absolute filesystem path to the external 256-bit keyfile protecting ERP connector secrets."
msgstr "Caminho absoluto no sistema de arquivos para o arquivo de chave externo de 256 bits que protege os segredos do conector ERP."

#: lib/Settings.php
msgid "Burst Budget Warning Threshold (%)"
msgstr "Limite de aviso da cota de pico (%)"

#: lib/Settings.php
msgid "Percentage of monthly burst slots consumed before raising a warning forecast."
msgstr "Percentual de intervalos mensais de pico consumidos antes de emitir uma previsão de aviso."

#: lib/Settings.php
msgid "Burst Budget Critical Threshold (%)"
msgstr "Limite crítico da cota de pico (%)"

#: lib/Settings.php
msgid "Percentage of monthly burst slots consumed before raising a critical forecast."
msgstr "Percentual de intervalos mensais de pico consumidos antes de emitir uma previsão crítica."

#: lib/Settings.php
msgid "Preserve Ledger Tables on Uninstall"
msgstr "Preservar tabelas de registro contábil ao desinstalar"

#: lib/Settings.php
msgid "Keep plugin_billing_* tables (including immutable samples and statements) when uninstalling."
msgstr "Manter as tabelas plugin_billing_* (incluindo amostras e demonstrativos imutáveis) ao desinstalar."

