#: lib/Settings.php
msgid "Rating & 95th-Percentile Defaults"
msgstr "Ücretlendirme ve 95. Yüzdelik Dilim Varsayılanları"

#: lib/Settings.php
msgid "Default Percentile"
msgstr "Varsayılan Yüzdelik Dilim"

#: lib/Settings.php
msgid "Default Nth percentile applied to new burstable contracts (50.0 to 100.0)."
msgstr "Yeni esnek kapasiteli sözleşmelere uygulanan varsayılan N. yüzdelik dilim (50.0 ile 100.0 arası)."

#: lib/Settings.php
msgid "Default Drop-Count Rounding"
msgstr "Varsayılan Düşürülen Aralık Yuvarlaması"

#: lib/Settings.php
msgid "Rounding mode for peak intervals dropped when computing the Nth percentile."
msgstr "N. yüzdelik dilim hesaplanırken dışarıda bırakılan tepe aralıkları için yuvarlama modu."

#: lib/Settings.php
msgid "Floor"
msgstr "Aşağı Yuvarla"

#: lib/Settings.php
msgid "Ceiling"
msgstr "Yukarı Yuvarla"

#: lib/Settings.php
msgid "Nearest"
msgstr "En Yakına Yuvarla"

#: lib/Settings.php
msgid "Default Missing-Sample Policy"
msgstr "Varsayılan Eksik Örnek İlkesi"

#: lib/Settings.php
msgid "How missing 5-minute intervals are treated during rating."
msgstr "Ücretlendirme sırasında eksik 5 dakikalık aralıkların nasıl ele alınacağı."

#: lib/Settings.php
msgid "Exclude gaps"
msgstr "Boşlukları hariç tut"

#: lib/Settings.php
msgid "Zero-fill missing slots"
msgstr "Eksik dilimleri sıfırla doldur"

#: lib/Settings.php
msgid "Carry forward previous sample"
msgstr "Önceki örneği ileri taşı"

#: lib/Settings.php
msgid "Default ISO 4217 Currency"
msgstr "Varsayılan ISO 4217 Para Birimi"

#: lib/Settings.php
msgid "Three-letter uppercase ISO 4217 currency code for new accounts and contracts."
msgstr "Yeni hesaplar ve sözleşmeler için üç büyük harfli ISO 4217 para birimi kodu."

#: lib/Settings.php
msgid "Counter Spike Cap Multiplier"
msgstr "Sayaç Sıçrama Üst Sınır Çarpanı"

#: lib/Settings.php
msgid "Maximum bps multiple of interface port speed before clamping counter spikes."
msgstr "Sayaç sıçramaları kırpılmadan önce arayüz bağlantı noktası hızının en fazla bps katı."

#: lib/Settings.php
msgid "Security, ERP Webhooks, and Retention"
msgstr "Güvenlik, ERP Web Kancaları ve Saklama"

#: lib/Settings.php
msgid "Outbound Webhook Timeout (seconds)"
msgstr "Giden Web Kancası Zaman Aşımı (saniye)"

#: lib/Settings.php
msgid "Bounded HTTPS timeout for ERP billing connector deliveries (1 to 60s)."
msgstr "ERP faturalandırma bağlayıcısı teslimatları için sınırlı HTTPS zaman aşımı (1 ile 60 sn arası)."

#: lib/Settings.php
msgid "Maximum Webhook Response Bytes"
msgstr "En Fazla Web Kancası Yanıt Baytı"

#: lib/Settings.php
msgid "Upper bound on bytes read from ERP webhook responses."
msgstr "ERP web kancası yanıtlarından okunan baytlar için üst sınır."

#: lib/Settings.php
msgid "AES-256-GCM External Keyfile Path"
msgstr "AES-256-GCM Harici Anahtar Dosyası Yolu"

#: lib/Settings.php
msgid "Absolute filesystem path to the external 256-bit keyfile protecting ERP connector secrets."
msgstr "ERP bağlayıcısı gizli bilgilerini koruyan harici 256 bitlik anahtar dosyasının mutlak dosya sistemi yolu."

#: lib/Settings.php
msgid "Burst Budget Warning Threshold (%)"
msgstr "Pik Kullanım Bütçesi Uyarı Eşiği (%)"

#: lib/Settings.php
msgid "Percentage of monthly burst slots consumed before raising a warning forecast."
msgstr "Uyarı tahmini oluşturulmadan önce tüketilen aylık pik kullanım dilimi yüzdesi."

#: lib/Settings.php
msgid "Burst Budget Critical Threshold (%)"
msgstr "Pik Kullanım Bütçesi Kritik Eşiği (%)"

#: lib/Settings.php
msgid "Percentage of monthly burst slots consumed before raising a critical forecast."
msgstr "Kritik tahmin oluşturulmadan önce tüketilen aylık pik kullanım dilimi yüzdesi."

#: lib/Settings.php
msgid "Preserve Ledger Tables on Uninstall"
msgstr "Kaldırırken Hesap Defteri Tablolarını Koru"

#: lib/Settings.php
msgid "Keep plugin_billing_* tables (including immutable samples and statements) when uninstalling."
msgstr "Kaldırma sırasında plugin_billing_* tablolarını (değiştirilemez örnekler ve hesap özetleri dahil) koru."

