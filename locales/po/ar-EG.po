msgstr "مشغّل الفوترة"

#: lib/Pages.php
msgid "Billing Admin"
msgstr "مسؤول الفوترة"

#: lib/Pages.php
msgid "Billing Usage & Forecasts"
msgstr "استخدام الفوترة والتوقعات"

#: lib/Pages.php
