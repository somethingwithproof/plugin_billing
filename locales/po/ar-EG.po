msgstr "كشوف الفوترة والتدقيق"

#: lib/Pages.php
msgid "Billing Accounts & Tariffs"
msgstr "حسابات الفوترة والتعريفات"

#: lib/Settings.php
msgid "Rating & 95th-Percentile Defaults"
msgstr "الإعدادات الافتراضية للتسعير والمئيني 95"

#: lib/Settings.php
msgid "Default Percentile"
msgstr "المئيني الافتراضي"

#: lib/Settings.php
msgid "Default Nth percentile applied to new burstable contracts (50.0 to 100.0)."
msgstr "المئيني الافتراضي المُطبّق على العقود الجديدة القابلة للتجاوز (من 50.0 إلى 100.0)."

#: lib/Settings.php
msgid "Default Drop-Count Rounding"
msgstr "تقريب عدد الفترات المستبعدة الافتراضي"

#: lib/Settings.php
msgid "Rounding mode for peak intervals dropped when computing the Nth percentile."
msgstr "وضع التقريب لفترات الذروة المستبعدة عند حساب المئيني."

#: lib/Settings.php
msgid "Floor"
msgstr "التقريب للأدنى"

#: lib/Settings.php
msgid "Ceiling"
msgstr "التقريب للأعلى"

#: lib/Settings.php
msgid "Nearest"
msgstr "الأقرب"

#: lib/Settings.php
msgid "Default Missing-Sample Policy"
msgstr "سياسة العينات المفقودة الافتراضية"

#: lib/Settings.php
msgid "How missing 5-minute intervals are treated during rating."
msgstr "كيفية التعامل مع الفترات المفقودة ذات الـ 5 دقائق أثناء التسعير."

#: lib/Settings.php
msgid "Exclude gaps"
msgstr "استبعاد الفجوات"

#: lib/Settings.php
msgid "Zero-fill missing slots"
msgstr "ملء الفترات المفقودة بأصفار"

#: lib/Settings.php
msgid "Carry forward previous sample"
msgstr "ترحيل العينة السابقة"

#: lib/Settings.php
msgid "Default ISO 4217 Currency"
msgstr "عملة ISO 4217 الافتراضية"

#: lib/Settings.php
msgid "Three-letter uppercase ISO 4217 currency code for new accounts and contracts."
msgstr "رمز عملة ISO 4217 المكون من ثلاثة أحرف كبيرة للحسابات والعقود الجديدة."

#: lib/Settings.php
msgid "Counter Spike Cap Multiplier"
msgstr "مضاعف حد طفرات العداد"

#: lib/Settings.php
msgid "Maximum bps multiple of interface port speed before clamping counter spikes."
msgstr "الحد الأقصى لمضاعف سرعة منفذ الواجهة بوحدة bps قبل تقييد طفرات العداد."

#: lib/Settings.php
msgid "Security, ERP Webhooks, and Retention"
msgstr "الأمان وروابط Webhook لأنظمة ERP والاحتفاظ بالبيانات"

#: lib/Settings.php
msgid "Outbound Webhook Timeout (seconds)"
msgstr "مهلة Webhook الصادر (بالثواني)"

#: lib/Settings.php
msgid "Bounded HTTPS timeout for ERP billing connector deliveries (1 to 60s)."
msgstr "مهلة HTTPS المحدودة لتسليمات موصّل فوترة ERP (من 1 إلى 60 ثانية)."

#: lib/Settings.php
msgid "Maximum Webhook Response Bytes"
msgstr "الحد الأقصى لبايتات استجابة Webhook"

#: lib/Settings.php
msgid "Upper bound on bytes read from ERP webhook responses."
msgstr "الحد الأعلى للبايتات المقروءة من استجابات Webhook الخاصة بنظام ERP."

#: lib/Settings.php
msgid "AES-256-GCM External Keyfile Path"
msgstr "مسار ملف المفتاح الخارجي AES-256-GCM"

#: lib/Settings.php
msgid "Absolute filesystem path to the external 256-bit keyfile protecting ERP connector secrets."
msgstr "المسار المطلق في نظام الملفات لملف المفتاح الخارجي بطول 256 بت الذي يحمي أسرار موصّل ERP."

#: lib/Settings.php
msgid "Burst Budget Warning Threshold (%)"
msgstr "حد التحذير لرصيد التجاوز (%)"

#: lib/Settings.php
msgid "Percentage of monthly burst slots consumed before raising a warning forecast."
msgstr "النسبة المئوية لفترات التجاوز الشهرية المستهلكة قبل إصدار توقع تحذيري."

#: lib/Settings.php
msgid "Burst Budget Critical Threshold (%)"
msgstr "الحد الحرج لرصيد التجاوز (%)"

#: lib/Settings.php
msgid "Percentage of monthly burst slots consumed before raising a critical forecast."
msgstr "النسبة المئوية لفترات التجاوز الشهرية المستهلكة قبل إصدار توقع حرج."

#: lib/Settings.php
msgid "Preserve Ledger Tables on Uninstall"
msgstr "الاحتفاظ بجداول السجل المحاسبي عند إلغاء التثبيت"

#: lib/Settings.php
msgid "Keep plugin_billing_* tables (including immutable samples and statements) when uninstalling."
msgstr "الاحتفاظ بجداول plugin_billing_* (بما في ذلك العينات وكشوف الحساب غير القابلة للتعديل) عند إلغاء التثبيت."

