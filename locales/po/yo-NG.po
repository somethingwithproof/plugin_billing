#: lib/Settings.php
msgid "Rating & 95th-Percentile Defaults"
msgstr "Àwọn Àtìpìlẹ̀ Ìdíyele àti Ìpín-ọgọ́rùn-ún 95"

#: lib/Settings.php
msgid "Default Percentile"
msgstr "Ìpín-ọgọ́rùn-ún Àtìpìlẹ̀"

#: lib/Settings.php
msgid "Default Nth percentile applied to new burstable contracts (50.0 to 100.0)."
msgstr "Ìpín-ọgọ́rùn-ún N àtìpìlẹ̀ tí a ń lò fún àwọn àdéhùn onígòkè ìlò tuntun (50.0 sí 100.0)."

#: lib/Settings.php
msgid "Default Drop-Count Rounding"
msgstr "Ìsúnpọ̀ Iye Ìyọkúrò Àtìpìlẹ̀"

#: lib/Settings.php
msgid "Rounding mode for peak intervals dropped when computing the Nth percentile."
msgstr "Ọ̀nà ìsúnpọ̀ fún àwọn àlàfo àkókò gíga tí a yọ kúrò nígbà tí a bá ń ṣírò ìpín-ọgọ́rùn-ún N."

#: lib/Settings.php
msgid "Floor"
msgstr "Ìsàlẹ̀"

#: lib/Settings.php
msgid "Ceiling"
msgstr "Òkè"

#: lib/Settings.php
msgid "Nearest"
msgstr "Tí ó sún mọ́ jù lọ"

#: lib/Settings.php
msgid "Default Missing-Sample Policy"
msgstr "Ìlànà Àpẹẹrẹ Tí Kò Sí Àtìpìlẹ̀"

#: lib/Settings.php
msgid "How missing 5-minute intervals are treated during rating."
msgstr "Bí a ṣe ń bójú tó àwọn àlàfo ìṣẹ́jú 5 tí kò sí nígbà ìdíyele."

#: lib/Settings.php
msgid "Exclude gaps"
msgstr "Yọ àwọn àlàfo kúrò"

#: lib/Settings.php
msgid "Zero-fill missing slots"
msgstr "Fi òdo kún àwọn ààyè tí kò sí"

#: lib/Settings.php
msgid "Carry forward previous sample"
msgstr "Gbé àpẹẹrẹ ìṣáájú lọ síwájú"

#: lib/Settings.php
msgid "Default ISO 4217 Currency"
msgstr "Oríṣi Owó ISO 4217 Àtìpìlẹ̀"

#: lib/Settings.php
msgid "Three-letter uppercase ISO 4217 currency code for new accounts and contracts."
msgstr "Kóòdù owó ISO 4217 onílẹ́tà mẹ́ta ní lẹ́tà ńlá fún àwọn àkọọ́lẹ̀ àti àdéhùn tuntun."

#: lib/Settings.php
msgid "Counter Spike Cap Multiplier"
msgstr "Olùsọdipúpọ̀ Ààlà Ìgòkè Òjijì Òǹkà"

#: lib/Settings.php
msgid "Maximum bps multiple of interface port speed before clamping counter spikes."
msgstr "Ìsọdipúpọ̀ bps tí ó pọ̀ jù lọ ti iyàrá pọ́ọ̀tì ìsopọ̀ ṣáájú dídá ìgòkè òjijì òǹkà dúró."

#: lib/Settings.php
msgid "Security, ERP Webhooks, and Retention"
msgstr "Ààbò, Àwọn Wẹ́bùhúùkì ERP, àti Ìpamọ́"

#: lib/Settings.php
msgid "Outbound Webhook Timeout (seconds)"
msgstr "Ààlà Àkókò Wẹ́bùhúùkì Ìjáde (ìṣẹ́jú-àáyá)"

#: lib/Settings.php
msgid "Bounded HTTPS timeout for ERP billing connector deliveries (1 to 60s)."
msgstr "Ààlà àkókò HTTPS tí ó ní ìdíwọ̀n fún ìfìránṣẹ́ olùsopọ̀ ìṣirò-owó ERP (ìṣẹ́jú-àáyá 1 sí 60)."

#: lib/Settings.php
msgid "Maximum Webhook Response Bytes"
msgstr "Iye Báìtì Ìdáhùn Wẹ́bùhúùkì Tí Ó Pọ̀ Jù"

#: lib/Settings.php
msgid "Upper bound on bytes read from ERP webhook responses."
msgstr "Ààlà òkè lórí àwọn báìtì tí a kà láti inú àwọn ìdáhùn wẹ́bùhúùkì ERP."

#: lib/Settings.php
msgid "AES-256-GCM External Keyfile Path"
msgstr "Ọ̀nà Fáìlì Kọ́kọ́rọ́ Òde AES-256-GCM"

#: lib/Settings.php
msgid "Absolute filesystem path to the external 256-bit keyfile protecting ERP connector secrets."
msgstr "Ọ̀nà ètò fáìlì pípé sí fáìlì kọ́kọ́rọ́ òde bíìtì 256 tí ń dáàbò bo àwọn àṣírí olùsopọ̀ ERP."

#: lib/Settings.php
msgid "Burst Budget Warning Threshold (%)"
msgstr "Ìpele Ààlà Ìkìlọ̀ Ìṣúná Ìgòkè Ìlò (%)"

#: lib/Settings.php
msgid "Percentage of monthly burst slots consumed before raising a warning forecast."
msgstr "Ìpín-ọgọ́rùn-ún àwọn ààyè ìgòkè ìlò oṣooṣù tí a lò ṣáájú fífúnni ní àsọtẹ́lẹ̀ ìkìlọ̀."

#: lib/Settings.php
msgid "Burst Budget Critical Threshold (%)"
msgstr "Ìpele Ààlà Ewu Gíga Ìṣúná Ìgòkè Ìlò (%)"

#: lib/Settings.php
msgid "Percentage of monthly burst slots consumed before raising a critical forecast."
msgstr "Ìpín-ọgọ́rùn-ún àwọn ààyè ìgòkè ìlò oṣooṣù tí a lò ṣáájú fífúnni ní àsọtẹ́lẹ̀ ewu gíga."

#: lib/Settings.php
msgid "Preserve Ledger Tables on Uninstall"
msgstr "Pa Àwọn Tábìlì Ìwé Ìṣirò Mọ́ Nígbà Ìyọkúrò"

#: lib/Settings.php
msgid "Keep plugin_billing_* tables (including immutable samples and statements) when uninstalling."
msgstr "Pa àwọn tábìlì plugin_billing_* mọ́ (pẹ̀lú àwọn àpẹẹrẹ àti àkọsílẹ̀ ìṣirò-owó tí kò ṣeé yí padà) nígbà tí a bá ń yọ àfikún kúrò."

