#: lib/Settings.php
msgid "Rating & 95th-Percentile Defaults"
msgstr "Valores predeterminados de tarificación y percentil 95"

#: lib/Settings.php
msgid "Default Percentile"
msgstr "Percentil predeterminado"

#: lib/Settings.php
msgid "Default Nth percentile applied to new burstable contracts (50.0 to 100.0)."
msgstr "Percentil N predeterminado aplicado a nuevos contratos con ráfaga (de 50.0 a 100.0)."

#: lib/Settings.php
msgid "Default Drop-Count Rounding"
msgstr "Redondeo predeterminado de muestras descartadas"

#: lib/Settings.php
msgid "Rounding mode for peak intervals dropped when computing the Nth percentile."
msgstr "Modo de redondeo para los intervalos pico descartados al calcular el percentil N."

#: lib/Settings.php
msgid "Floor"
msgstr "Hacia abajo"

#: lib/Settings.php
msgid "Ceiling"
msgstr "Hacia arriba"

#: lib/Settings.php
msgid "Nearest"
msgstr "Más cercano"

#: lib/Settings.php
msgid "Default Missing-Sample Policy"
msgstr "Política predeterminada para muestras faltantes"

#: lib/Settings.php
msgid "How missing 5-minute intervals are treated during rating."
msgstr "Cómo se tratan los intervalos de 5 minutos faltantes durante la tarificación."

#: lib/Settings.php
msgid "Exclude gaps"
msgstr "Excluir huecos"

#: lib/Settings.php
msgid "Zero-fill missing slots"
msgstr "Rellenar con ceros los intervalos faltantes"

#: lib/Settings.php
msgid "Carry forward previous sample"
msgstr "Arrastrar la muestra anterior"

#: lib/Settings.php
msgid "Default ISO 4217 Currency"
msgstr "Divisa ISO 4217 predeterminada"

#: lib/Settings.php
msgid "Three-letter uppercase ISO 4217 currency code for new accounts and contracts."
msgstr "Código de divisa ISO 4217 de tres letras en mayúsculas para nuevas cuentas y contratos."

#: lib/Settings.php
msgid "Counter Spike Cap Multiplier"
msgstr "Multiplicador límite para picos de contador"

#: lib/Settings.php
msgid "Maximum bps multiple of interface port speed before clamping counter spikes."
msgstr "Múltiplo máximo en bps de la velocidad del puerto de interfaz antes de recortar los picos del contador."

#: lib/Settings.php
msgid "Security, ERP Webhooks, and Retention"
msgstr "Seguridad, webhooks ERP y retención"

#: lib/Settings.php
msgid "Outbound Webhook Timeout (seconds)"
msgstr "Tiempo de espera de webhook saliente (segundos)"

#: lib/Settings.php
msgid "Bounded HTTPS timeout for ERP billing connector deliveries (1 to 60s)."
msgstr "Tiempo de espera HTTPS acotado para envíos de conectores de facturación ERP (de 1 a 60 s)."

#: lib/Settings.php
msgid "Maximum Webhook Response Bytes"
msgstr "Bytes máximos de respuesta de webhook"

#: lib/Settings.php
msgid "Upper bound on bytes read from ERP webhook responses."
msgstr "Límite superior de bytes leídos de las respuestas de webhooks ERP."

#: lib/Settings.php
msgid "AES-256-GCM External Keyfile Path"
msgstr "Ruta del archivo de clave externa AES-256-GCM"

#: lib/Settings.php
msgid "Absolute filesystem path to the external 256-bit keyfile protecting ERP connector secrets."
msgstr "Ruta absoluta del sistema de archivos al archivo de clave externa de 256 bits que protege los secretos de conectores ERP."

#: lib/Settings.php
msgid "Burst Budget Warning Threshold (%)"
msgstr "Umbral de aviso del margen de ráfaga (%)"

#: lib/Settings.php
msgid "Percentage of monthly burst slots consumed before raising a warning forecast."
msgstr "Porcentaje de intervalos mensuales de ráfaga consumidos antes de emitir una previsión de aviso."

#: lib/Settings.php
msgid "Burst Budget Critical Threshold (%)"
msgstr "Umbral crítico del margen de ráfaga (%)"

#: lib/Settings.php
msgid "Percentage of monthly burst slots consumed before raising a critical forecast."
msgstr "Porcentaje de intervalos mensuales de ráfaga consumidos antes de emitir una previsión crítica."

#: lib/Settings.php
msgid "Preserve Ledger Tables on Uninstall"
msgstr "Conservar tablas de registro contable al desinstalar"

#: lib/Settings.php
msgid "Keep plugin_billing_* tables (including immutable samples and statements) when uninstalling."
msgstr "Conservar las tablas plugin_billing_* (incluidas las muestras y los extractos inmutables) al desinstalar."

