msgid "CSRF verification failed. Reload the page and retry."
msgstr "Xaqiijinta CSRF way fashilantay. Dib u rar bogga oo mar kale isku day."

#: billing_admin.php
msgid "Saved billing account."
msgstr "Waa la kaydiyay koontada biilasha."

#: billing_admin.php
msgid "Saved plugin_billing configuration."
msgstr "Waa la kaydiyay habaynta plugin_billing."

#: billing_admin.php
msgid "Unable to save plugin_billing configuration."
msgstr "Lama kaydin karin habaynta plugin_billing."

#: billing_admin.php
msgid "Unsupported administrator action."
msgstr "Tallaabo maamule oo aan la taageerin."

#: billing_admin.php
msgid "Billing Accounts, Contracts, Tariffs & ERP Connectors (Administrator)"
msgstr "Koontooyinka Biilasha, Qandaraasyada, Tacriifadaha iyo Xiriiriyeyaasha ERP (Maamule)"

#: billing_operator.php
#, php-format
msgid "Statement \"%s\" SHA-256 integrity verified."
msgstr "Hufnaanta SHA-256 ee bayaanka \"%s\" waa la xaqiijiyay."

#: billing_operator.php
#, php-format
msgid "Statement \"%s\" verification failed: %s"
msgstr "Xaqiijinta bayaanka \"%s\" way fashilantay: %s"

#: billing_operator.php
msgid "Provide valid UTC start and end dates."
msgstr "Bixi taariikho bilow iyo dhammaad UTC oo sax ah."

#: billing_operator.php
#, php-format
msgid "Dry-run rating for %s: %s %s"
msgstr "Qiimaynta tijaabada ee %s: %s %s"

#: billing_operator.php
msgid "Statement not found."
msgstr "Bayaanka lama helin."

#: billing_operator.php
msgid "Unsupported operator action."
msgstr "Tallaabo hawl-wadeen oo aan la taageerin."

#: billing_operator.php
msgid "Billing Statement Audit, Proof Verification & Exports (Operator)"
msgstr "Hanti-dhawrka Bayaannada Biilasha, Xaqiijinta Caddaynta iyo Dhoofinta (Hawl-wadeen)"

#: billing_view.php
msgid "Billing Usage & Mid-Cycle Burst Forecasts"
msgstr "Isticmaalka Biilasha iyo Saadaasha Kororka Xawaaraha ee Bartamaha Wareegga"

#: lib/Pages.php
msgid "Billing View"
msgstr "Eegista Biilasha"

#: lib/Pages.php
msgid "Billing Operator"
msgstr "Hawl-wadeenka Biilasha"

#: lib/Pages.php
msgid "Billing Admin"
msgstr "Maamulka Biilasha"

#: lib/Pages.php
msgid "Billing Usage & Forecasts"
msgstr "Isticmaalka Biilasha iyo Saadaasha"

#: lib/Pages.php
msgid "Billing Statements & Audit"
msgstr "Bayaannada Biilasha iyo Hanti-dhawrka"

#: lib/Pages.php
msgid "Billing Accounts & Tariffs"
msgstr "Koontooyinka Biilasha iyo Tacriifadaha"

#: lib/Settings.php
msgid "Rating & 95th-Percentile Defaults"
msgstr "Qiimaynta iyo Habaynta Caadiga ah ee Boqolleyda 95-aad"

#: lib/Settings.php
msgid "Default Percentile"
msgstr "Boqolleyda Caadiga ah"

#: lib/Settings.php
msgid "Default Nth percentile applied to new burstable contracts (50.0 to 100.0)."
msgstr "Boqolleyda N-aad ee caadiga ah ee lagu dabaqo qandaraasyada cusub ee koror-xawaare leh (50.0 ilaa 100.0)."

#: lib/Settings.php
msgid "Default Drop-Count Rounding"
msgstr "Wareejinta Caadiga ah ee Tirada la Tuuro"

#: lib/Settings.php
msgid "Rounding mode for peak intervals dropped when computing the Nth percentile."
msgstr "Habka wareejinta ee xilliyada ugu sarreeya ee la tuuro marka la xisaabinayo boqolleyda N-aad."

#: lib/Settings.php
msgid "Floor"
msgstr "Hoos u wareejin"

#: lib/Settings.php
msgid "Ceiling"
msgstr "Kor u wareejin"

#: lib/Settings.php
msgid "Nearest"
msgstr "Kan ugu dhow"

#: lib/Settings.php
msgid "Default Missing-Sample Policy"
msgstr "Siyaasadda Caadiga ah ee Muunadaha Maqan"

#: lib/Settings.php
msgid "How missing 5-minute intervals are treated during rating."
msgstr "Sida loola dhaqmo xilliyada 5-daqiiqo ee maqan inta lagu jiro qiimaynta."

#: lib/Settings.php
msgid "Exclude gaps"
msgstr "Ka saar farqiyada maqan"

#: lib/Settings.php
msgid "Zero-fill missing slots"
msgstr "Eber ku buuxi boosaska maqan"

#: lib/Settings.php
msgid "Carry forward previous sample"
msgstr "Hore u sii wad muunaddii hore"

#: lib/Settings.php
msgid "Default ISO 4217 Currency"
msgstr "Lacagta Caadiga ah ee ISO 4217"

#: lib/Settings.php
msgid "Three-letter uppercase ISO 4217 currency code for new accounts and contracts."
msgstr "Koodhka lacagta ISO 4217 ee saddexda xaraf oo waaweyn ah loogu talagalay koontooyinka iyo qandaraasyada cusub."

#: lib/Settings.php
msgid "Counter Spike Cap Multiplier"
msgstr "Isku-dhufashada Xadka Kororka Degdegga ah ee Tiriyaha"

#: lib/Settings.php
msgid "Maximum bps multiple of interface port speed before clamping counter spikes."
msgstr "Isku-dhufashada ugu badan ee bps ee xawaaraha dekadda is-dhexgalka ka hor inta aan la xaddidin kororka degdegga ah ee tiriyaha."

#: lib/Settings.php
msgid "Security, ERP Webhooks, and Retention"
msgstr "Amniga, Xiriiriyeyaasha Webka ERP, iyo Xafididda"

#: lib/Settings.php
msgid "Outbound Webhook Timeout (seconds)"
msgstr "Waqtiga Dhammaadka Xiriiriyaha Webka ee Baxa (ilbiriqsiyo)"

#: lib/Settings.php
msgid "Bounded HTTPS timeout for ERP billing connector deliveries (1 to 60s)."
msgstr "Waqtiga dhammaadka HTTPS ee xaddidan ee gaarsiinta xiriiriyaha biilasha ERP (1 ilaa 60s)."

#: lib/Settings.php
msgid "Maximum Webhook Response Bytes"
msgstr "Baytyada Ugu Badan ee Jawaabta Xiriiriyaha Webka"

#: lib/Settings.php
msgid "Upper bound on bytes read from ERP webhook responses."
msgstr "Xadka ugu sarreeya ee baytyada laga akhriyo jawaabaha xiriiriyaha webka ERP."

#: lib/Settings.php
msgid "AES-256-GCM External Keyfile Path"
msgstr "Waddada Faylka Furaha Dibadda ee AES-256-GCM"

#: lib/Settings.php
msgid "Absolute filesystem path to the external 256-bit keyfile protecting ERP connector secrets."
msgstr "Waddada buuxda ee nidaamka faylasha ee u socota faylka furaha dibadda ee 256-bit ee ilaaliya siraha xiriiriyaha ERP."

#: lib/Settings.php
msgid "Burst Budget Warning Threshold (%)"
msgstr "Heerka Digniinta Miisaaniyadda Kororka Xawaaraha (%)"

#: lib/Settings.php
msgid "Percentage of monthly burst slots consumed before raising a warning forecast."
msgstr "Boqolkiiba boosaska kororka xawaaraha ee bisha ee la isticmaalay ka hor inta aan la soo saarin saadaal digniin ah."

#: lib/Settings.php
msgid "Burst Budget Critical Threshold (%)"
msgstr "Heerka Khatarta Miisaaniyadda Kororka Xawaaraha (%)"

#: lib/Settings.php
msgid "Percentage of monthly burst slots consumed before raising a critical forecast."
msgstr "Boqolkiiba boosaska kororka xawaaraha ee bisha ee la isticmaalay ka hor inta aan la soo saarin saadaal khatar ah."

#: lib/Settings.php
msgid "Preserve Ledger Tables on Uninstall"
msgstr "Xafid Jadwallada Buugga Xisaabta Marka la Tirtiro"

#: lib/Settings.php
msgid "Keep plugin_billing_* tables (including immutable samples and statements) when uninstalling."
msgstr "Hay jadwallada plugin_billing_* (oo ay ku jiraan muunadaha iyo bayaannada aan la beddeli karin) marka la tirtirayo."

#: setup.php
#, php-format
msgid "The Billing plugin requires PHP %s or later. This server runs PHP %s, so the plugin was not installed or enabled."
msgstr "Kordhinta Biilasha waxay u baahan tahay PHP %s ama ka dambeeya. Adeegahani wuxuu ku shaqeeyaa PHP %s, sidaas darteed kordhinta lama rakibin lamana hawl-gelin."

#: setup.php
msgid "Utilities"
msgstr "Qalabyada"

#: setup.php
msgid "Billing"
msgstr "Biilasha"

#: setup.php
msgid "Burstable Transit & Usage Billing"
msgstr "Biilasha Isticmaalka iyo Gudbinta Koror-xawaare leh"

#: setup.php
msgid "The Billing plugin is not enabled."
msgstr "Kordhinta Biilasha ma daarana."

