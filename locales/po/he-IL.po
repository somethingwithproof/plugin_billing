msgstr "פעולת מנהל מערכת אינה נתמכת."

#: billing_admin.php
msgid "Billing Accounts, Contracts, Tariffs & ERP Connectors (Administrator)"
msgstr "חשבונות חיוב, חוזים, תעריפים ומחברי ERP (מנהל מערכת)"

#: billing_operator.php
#, php-format
