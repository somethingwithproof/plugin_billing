msgid "Maximum bps multiple of interface port speed before clamping counter spikes."
msgstr "Maximaal bps-veelvoud van de interfacepoortsnelheid voordat tellerpieken worden afgetopt."

#: lib/Settings.php
msgid "Security, ERP Webhooks, and Retention"
msgstr "Beveiliging, ERP-webhooks en bewaartermijn"

#: lib/Settings.php
msgid "Outbound Webhook Timeout (seconds)"
msgstr "Time-out voor uitgaande webhooks (seconden)"

#: lib/Settings.php
msgid "Bounded HTTPS timeout for ERP billing connector deliveries (1 to 60s)."
msgstr "Begrensde HTTPS-time-out voor leveringen via de ERP-facturatiekoppeling (1 tot 60 s)."

#: lib/Settings.php
msgid "Maximum Webhook Response Bytes"
msgstr "Maximaal aantal bytes voor webhookantwoorden"

#: lib/Settings.php
msgid "Upper bound on bytes read from ERP webhook responses."
msgstr "Bovengrens voor het aantal bytes dat wordt gelezen uit ERP-webhookantwoorden."

#: lib/Settings.php
msgid "AES-256-GCM External Keyfile Path"
msgstr "Pad naar extern AES-256-GCM-sleutelbestand"

#: lib/Settings.php
msgid "Absolute filesystem path to the external 256-bit keyfile protecting ERP connector secrets."
msgstr "Absoluut bestandssysteempad naar het externe 256-bits sleutelbestand dat geheimen van ERP-koppelingen beschermt."

#: lib/Settings.php
msgid "Burst Budget Warning Threshold (%)"
msgstr "Waarschuwingsdrempel voor piekbudget (%)"

#: lib/Settings.php
msgid "Percentage of monthly burst slots consumed before raising a warning forecast."
msgstr "Percentage verbruikte maandelijkse piektijdvakken voordat een waarschuwingsprognose wordt gegenereerd."

#: lib/Settings.php
msgid "Burst Budget Critical Threshold (%)"
msgstr "Kritieke drempel voor piekbudget (%)"

#: lib/Settings.php
msgid "Percentage of monthly burst slots consumed before raising a critical forecast."
msgstr "Percentage verbruikte maandelijkse piektijdvakken voordat een kritieke prognose wordt gegenereerd."

#: lib/Settings.php
msgid "Preserve Ledger Tables on Uninstall"
msgstr "Grootboektabellen behouden bij verwijderen"

#: lib/Settings.php
msgid "Keep plugin_billing_* tables (including immutable samples and statements) when uninstalling."
msgstr "Behoud de tabellen van plugin_billing_* (inclusief onveranderlijke metingen en afschriften) bij het verwijderen."

