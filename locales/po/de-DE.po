#: lib/Settings.php
msgid "How missing 5-minute intervals are treated during rating."
msgstr "Wie fehlende 5-Minuten-Intervalle bei der Tarifierung behandelt werden."

#: lib/Settings.php
msgid "Exclude gaps"
msgstr "Lücken ausschließen"

#: lib/Settings.php
msgid "Zero-fill missing slots"
msgstr "Fehlende Zeitfenster mit Null füllen"

#: lib/Settings.php
msgid "Carry forward previous sample"
msgstr "Vorherigen Messwert fortschreiben"

#: lib/Settings.php
msgid "Default ISO 4217 Currency"
msgstr "Standardwährung nach ISO 4217"

#: lib/Settings.php
msgid "Three-letter uppercase ISO 4217 currency code for new accounts and contracts."
msgstr "Dreistelliger Währungscode nach ISO 4217 in Großbuchstaben für neue Konten und Verträge."

#: lib/Settings.php
msgid "Counter Spike Cap Multiplier"
msgstr "Begrenzungsfaktor für Zählerspitzen"

#: lib/Settings.php
msgid "Maximum bps multiple of interface port speed before clamping counter spikes."
msgstr "Maximales bps-Vielfaches der Schnittstellen-Portgeschwindigkeit, bevor Zählerspitzen gekappt werden."

#: lib/Settings.php
msgid "Security, ERP Webhooks, and Retention"
msgstr "Sicherheit, ERP-Webhooks und Aufbewahrung"

#: lib/Settings.php
msgid "Outbound Webhook Timeout (seconds)"
msgstr "Zeitlimit für ausgehende Webhooks (Sekunden)"

#: lib/Settings.php
msgid "Bounded HTTPS timeout for ERP billing connector deliveries (1 to 60s)."
msgstr "Begrenztes HTTPS-Zeitlimit für Zustellungen über ERP-Abrechnungskonnektoren (1 bis 60 s)."

#: lib/Settings.php
msgid "Maximum Webhook Response Bytes"
msgstr "Maximale Webhook-Antwortgröße (Bytes)"

#: lib/Settings.php
msgid "Upper bound on bytes read from ERP webhook responses."
msgstr "Obergrenze für die aus ERP-Webhook-Antworten gelesenen Bytes."

#: lib/Settings.php
msgid "AES-256-GCM External Keyfile Path"
msgstr "Pfad zur externen AES-256-GCM-Schlüsseldatei"

#: lib/Settings.php
msgid "Absolute filesystem path to the external 256-bit keyfile protecting ERP connector secrets."
msgstr "Absoluter Dateisystempfad zur externen 256-Bit-Schlüsseldatei zum Schutz der Geheimnisse von ERP-Konnektoren."

#: lib/Settings.php
msgid "Burst Budget Warning Threshold (%)"
msgstr "Warnschwelle für Burst-Budget (%)"

#: lib/Settings.php
msgid "Percentage of monthly burst slots consumed before raising a warning forecast."
msgstr "Prozentsatz der verbrauchten monatlichen Burst-Zeitfenster, ab dem eine Warnprognose ausgelöst wird."

#: lib/Settings.php
msgid "Burst Budget Critical Threshold (%)"
msgstr "Kritische Schwelle für Burst-Budget (%)"

#: lib/Settings.php
msgid "Percentage of monthly burst slots consumed before raising a critical forecast."
msgstr "Prozentsatz der verbrauchten monatlichen Burst-Zeitfenster, ab dem eine kritische Prognose ausgelöst wird."

#: lib/Settings.php
msgid "Preserve Ledger Tables on Uninstall"
msgstr "Buchungstabellen bei Deinstallation behalten"

#: lib/Settings.php
msgid "Keep plugin_billing_* tables (including immutable samples and statements) when uninstalling."
msgstr "Die Tabellen plugin_billing_* (einschließlich unveränderlicher Messwerte und Abrechnungsbelege) bei der Deinstallation beibehalten."

