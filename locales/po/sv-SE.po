#: lib/Settings.php
msgid "Rating & 95th-Percentile Defaults"
msgstr "Standardinställningar för taxering och 95:e percentilen"

#: lib/Settings.php
msgid "Default Percentile"
msgstr "Standardpercentil"

#: lib/Settings.php
msgid "Default Nth percentile applied to new burstable contracts (50.0 to 100.0)."
msgstr "Standardvärde för N:te percentilen som tillämpas på nya burstbara avtal (50.0 till 100.0)."

#: lib/Settings.php
msgid "Default Drop-Count Rounding"
msgstr "Standardavrundning för borträknade toppintervall"

#: lib/Settings.php
msgid "Rounding mode for peak intervals dropped when computing the Nth percentile."
msgstr "Avrundningsläge för toppintervall som räknas bort vid beräkning av den N:te percentilen."

#: lib/Settings.php
msgid "Floor"
msgstr "Avrunda nedåt"

#: lib/Settings.php
msgid "Ceiling"
msgstr "Avrunda uppåt"

#: lib/Settings.php
msgid "Nearest"
msgstr "Närmaste"

#: lib/Settings.php
msgid "Default Missing-Sample Policy"
msgstr "Standardpolicy för saknade mätvärden"

#: lib/Settings.php
msgid "How missing 5-minute intervals are treated during rating."
msgstr "Hur saknade 5-minutersintervall hanteras vid taxering."

#: lib/Settings.php
msgid "Exclude gaps"
msgstr "Exkludera luckor"

#: lib/Settings.php
msgid "Zero-fill missing slots"
msgstr "Fyll saknade intervall med noll"

#: lib/Settings.php
msgid "Carry forward previous sample"
msgstr "För vidare föregående mätvärde"

#: lib/Settings.php
msgid "Default ISO 4217 Currency"
msgstr "Standardvaluta enligt ISO 4217"

#: lib/Settings.php
msgid "Three-letter uppercase ISO 4217 currency code for new accounts and contracts."
msgstr "Valutakod med tre versaler enligt ISO 4217 för nya konton och avtal."

#: lib/Settings.php
msgid "Counter Spike Cap Multiplier"
msgstr "Multiplikator för tak på räknartoppar"

#: lib/Settings.php
msgid "Maximum bps multiple of interface port speed before clamping counter spikes."
msgstr "Högsta multipel i bps av gränssnittets porthastighet innan räknartoppar begränsas."

#: lib/Settings.php
msgid "Security, ERP Webhooks, and Retention"
msgstr "Säkerhet, ERP-webhooks och lagringstid"

#: lib/Settings.php
msgid "Outbound Webhook Timeout (seconds)"
msgstr "Tidsgräns för utgående webhook (sekunder)"

#: lib/Settings.php
msgid "Bounded HTTPS timeout for ERP billing connector deliveries (1 to 60s)."
msgstr "Begränsad HTTPS-tidsgräns för leveranser via ERP-faktureringskoppling (1 till 60 s)."

#: lib/Settings.php
msgid "Maximum Webhook Response Bytes"
msgstr "Maximal svarsstorlek för webhook (byte)"

#: lib/Settings.php
msgid "Upper bound on bytes read from ERP webhook responses."
msgstr "Övre gräns för antal byte som läses från ERP-webhooksvar."

#: lib/Settings.php
msgid "AES-256-GCM External Keyfile Path"
msgstr "Sökväg till extern AES-256-GCM-nyckelfil"

#: lib/Settings.php
msgid "Absolute filesystem path to the external 256-bit keyfile protecting ERP connector secrets."
msgstr "Absolut filsystemssökväg till den externa 256-bitars nyckelfilen som skyddar hemligheter för ERP-kopplingar."

#: lib/Settings.php
msgid "Burst Budget Warning Threshold (%)"
msgstr "Varningströskel för burstbudget (%)"

#: lib/Settings.php
msgid "Percentage of monthly burst slots consumed before raising a warning forecast."
msgstr "Procentandel av månadens burstintervall som förbrukats innan en varningsprognos utlöses."

#: lib/Settings.php
msgid "Burst Budget Critical Threshold (%)"
msgstr "Kritisk tröskel för burstbudget (%)"

#: lib/Settings.php
msgid "Percentage of monthly burst slots consumed before raising a critical forecast."
msgstr "Procentandel av månadens burstintervall som förbrukats innan en kritisk prognos utlöses."

#: lib/Settings.php
msgid "Preserve Ledger Tables on Uninstall"
msgstr "Behåll transaktionstabeller vid avinstallation"

#: lib/Settings.php
msgid "Keep plugin_billing_* tables (including immutable samples and statements) when uninstalling."
msgstr "Behåll tabellerna plugin_billing_* (inklusive oföränderliga mätvärden och fakturaunderlag) vid avinstallation."

