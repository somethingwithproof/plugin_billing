#: lib/Settings.php
msgid "Burst Budget Critical Threshold (%)"
msgstr "Kritični prag budžeta prekoračenja (%)"

#: lib/Settings.php
msgid "Percentage of monthly burst slots consumed before raising a critical forecast."
msgstr "Procenat potrošenih mjesečnih slotova prekoračenja prije izdavanja kritične prognoze."

