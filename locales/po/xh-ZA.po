msgstr "Umphathi-misebenzi woBalo-ntlawulo"

#: lib/Pages.php
msgid "Billing Admin"
msgstr "Umlawuli woBalo-ntlawulo"

#: lib/Pages.php
msgid "Billing Usage & Forecasts"
msgstr "Ukusetyenziswa koBalo-ntlawulo noQikelelo"

#: lib/Pages.php
msgid "Billing Statements & Audit"
msgstr "Iingxelo zoBalo-ntlawulo noPhicotho"

#: lib/Pages.php
msgid "Billing Accounts & Tariffs"
msgstr "IiAkhawunti zoBalo-ntlawulo neMirhumo"

#: lib/Settings.php
msgid "Rating & 95th-Percentile Defaults"
msgstr "Okumiselweyo koBalo lwemirhumo nePhesentayile ye-95"

#: lib/Settings.php
msgid "Default Percentile"
msgstr "Iphesentayile Emiselweyo"

#: lib/Settings.php
msgid "Default Nth percentile applied to new burstable contracts (50.0 to 100.0)."
msgstr "Iphesentayile ye-N emiselweyo esetyenziswa kwizivumelwano ezitsha ezinogqabhuko (50.0 ukuya ku-100.0)."

#: lib/Settings.php
msgid "Default Drop-Count Rounding"
msgstr "Ukusondeza okuMiselweyo kweNani elishiywayo"

#: lib/Settings.php
msgid "Rounding mode for peak intervals dropped when computing the Nth percentile."
msgstr "Indlela yokusondeza kumanqanaba aphezulu ashiywayo xa kubalwa iphesentayile ye-N."

#: lib/Settings.php
msgid "Floor"
msgstr "Isiseko (phantsi)"

#: lib/Settings.php
msgid "Ceiling"
msgstr "Uphahla (phezulu)"

#: lib/Settings.php
msgid "Nearest"
msgstr "Elikufutshane"

#: lib/Settings.php
msgid "Default Missing-Sample Policy"
msgstr "Umgaqo-nkqubo Omiselweyo weeSampuli Ezingekhoyo"

#: lib/Settings.php
msgid "How missing 5-minute intervals are treated during rating."
msgstr "Indlela izithuba zemizuzu emi-5 ezingekhoyo eziphathwa ngayo ngexesha lokubala umrhumo."

#: lib/Settings.php
msgid "Exclude gaps"
msgstr "Khupha izikhewu"

#: lib/Settings.php
msgid "Zero-fill missing slots"
msgstr "Zalisa izithuba ezingekhoyo ngo-zero"

#: lib/Settings.php
msgid "Carry forward previous sample"
msgstr "Gqithisela phambili isampuli edlulileyo"

#: lib/Settings.php
msgid "Default ISO 4217 Currency"
msgstr "Imali ye-ISO 4217 Emiselweyo"

#: lib/Settings.php
msgid "Three-letter uppercase ISO 4217 currency code for new accounts and contracts."
msgstr "Ikhowudi yemali ye-ISO 4217 enoonobumba abathathu abakhulu yeeakhawunti nezivumelwano ezitsha."

#: lib/Settings.php
msgid "Counter Spike Cap Multiplier"
msgstr "Isiphindaphindi soMda wokuNyuka ngequbuliso kweKhawunta"

#: lib/Settings.php
msgid "Maximum bps multiple of interface port speed before clamping counter spikes."
msgstr "Elona phindaphindo liphezulu le-bps lesantya sephothi yojongano phambi kokuthintela ukunyuka ngequbuliso kwekhawunta."

#: lib/Settings.php
msgid "Security, ERP Webhooks, and Retention"
msgstr "Ukhuseleko, ii-Webhook ze-ERP, noGcino"

#: lib/Settings.php
msgid "Outbound Webhook Timeout (seconds)"
msgstr "Ixesha Lokuphela kwe-Webhook Ephumayo (imizuzwana)"

#: lib/Settings.php
msgid "Bounded HTTPS timeout for ERP billing connector deliveries (1 to 60s)."
msgstr "Ixesha elilinganiselweyo lokuphela kwe-HTTPS lokuthunyelwa kwesiqhagamsheli sobalo-ntlawulo se-ERP (1 ukuya ku-60s)."

#: lib/Settings.php
msgid "Maximum Webhook Response Bytes"
msgstr "Elona Nani Liphezulu leeBhayithi zeMpendulo ye-Webhook"

#: lib/Settings.php
msgid "Upper bound on bytes read from ERP webhook responses."
msgstr "Umda ophezulu weebhayithi ezifundwa kwiimpendulo ze-webhook ze-ERP."

#: lib/Settings.php
msgid "AES-256-GCM External Keyfile Path"
msgstr "Indlela yeFayile yeSitshixo sangaphandle se-AES-256-GCM"

#: lib/Settings.php
msgid "Absolute filesystem path to the external 256-bit keyfile protecting ERP connector secrets."
msgstr "Indlela epheleleyo yenkqubo yefayile eya kwifayile yesitshixo sangaphandle se-256-bit ekhusela iimfihlo zesiqhagamsheli se-ERP."

#: lib/Settings.php
msgid "Burst Budget Warning Threshold (%)"
msgstr "Umda weSilumkiso soHlahlo-lwabiwo loGqabhuko (%)"

#: lib/Settings.php
msgid "Percentage of monthly burst slots consumed before raising a warning forecast."
msgstr "Ipesenti yezithuba zogqabhuko zenyanga ezisetyenzisiweyo phambi kokuphakamisa uqikelelo lwesilumkiso."

#: lib/Settings.php
msgid "Burst Budget Critical Threshold (%)"
msgstr "Umda oNgxamisekileyo woHlahlo-lwabiwo loGqabhuko (%)"

#: lib/Settings.php
msgid "Percentage of monthly burst slots consumed before raising a critical forecast."
msgstr "Ipesenti yezithuba zogqabhuko zenyanga ezisetyenzisiweyo phambi kokuphakamisa uqikelelo olungxamisekileyo."

#: lib/Settings.php
msgid "Preserve Ledger Tables on Uninstall"
msgstr "Gcina iiTheyibhile zeLeja xa Kukhutshwa"

#: lib/Settings.php
msgid "Keep plugin_billing_* tables (including immutable samples and statements) when uninstalling."
msgstr "Gcina iitheyibhile ze-plugin_billing_* (kubandakanya iisampuli ezingaguqukiyo neengxelo) xa kukhutshwa isongezelelo."

