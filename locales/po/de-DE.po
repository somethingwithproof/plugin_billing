msgid "Rating & 95th-Percentile Defaults"
msgstr "Standardwerte für Tarifierung & 95.-Perzentil"

#: lib/Settings.php
msgid "Default Percentile"
msgstr "Standard-Perzentil"

#: lib/Settings.php
msgid "Default Nth percentile applied to new burstable contracts (50.0 to 100.0)."
msgstr "Standardmäßiges N-tes Perzentil für neue Verträge mit Burst-Modell (50.0 bis 100.0)."

#: lib/Settings.php
msgid "Default Drop-Count Rounding"
msgstr "Standardrundung der verworfenen Spitzenintervalle"

