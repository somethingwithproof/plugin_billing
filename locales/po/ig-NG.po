#: lib/Settings.php
msgid "Rating & 95th-Percentile Defaults"
msgstr "Ndabara Ịtụle Ọnụahịa na Pasentịlụ nke 95"

#: lib/Settings.php
msgid "Default Percentile"
msgstr "Pasentịlụ Ndabara"

#: lib/Settings.php
msgid "Default Nth percentile applied to new burstable contracts (50.0 to 100.0)."
msgstr "Pasentịlụ nke N ndabara etinyere na nkwekọrịta ọhụrụ nwere ohere mmụba (50.0 ruo 100.0)."

#: lib/Settings.php
msgid "Default Drop-Count Rounding"
msgstr "Mgbatị Ọnụọgụ Mwepụ Ndabara"

#: lib/Settings.php
msgid "Rounding mode for peak intervals dropped when computing the Nth percentile."
msgstr "Ụdị mgbatị maka oge kachasị elu ewepụrụ mgbe a na-agbakọ pasentịlụ nke N."

#: lib/Settings.php
msgid "Floor"
msgstr "Ala"

#: lib/Settings.php
msgid "Ceiling"
msgstr "Elu"

#: lib/Settings.php
msgid "Nearest"
msgstr "Kasị nso"

#: lib/Settings.php
msgid "Default Missing-Sample Policy"
msgstr "Iwu Ihe Nlele Na-efu nke Ndabara"

#: lib/Settings.php
msgid "How missing 5-minute intervals are treated during rating."
msgstr "Otu esi emeso oge nkeji 5 na-efu n'oge ịtụle ọnụahịa."

#: lib/Settings.php
msgid "Exclude gaps"
msgstr "Wepụ oghere ndị na-efu"

#: lib/Settings.php
msgid "Zero-fill missing slots"
msgstr "Jiri efu mejupụta oghere na-efu"

#: lib/Settings.php
msgid "Carry forward previous sample"
msgstr "Bufee ihe nlele gara aga n'ihu"

#: lib/Settings.php
msgid "Default ISO 4217 Currency"
msgstr "Ego ISO 4217 Ndabara"

#: lib/Settings.php
msgid "Three-letter uppercase ISO 4217 currency code for new accounts and contracts."
msgstr "Koodu ego ISO 4217 nwere mkpụrụedemede ukwu atọ maka akaụntụ na nkwekọrịta ọhụrụ."

#: lib/Settings.php
msgid "Counter Spike Cap Multiplier"
msgstr "Ihe Mmụba Oke Mgbochi Mmụba Ngụkọ"

#: lib/Settings.php
msgid "Maximum bps multiple of interface port speed before clamping counter spikes."
msgstr "Ọnụọgụ mmụba bps kasị elu nke ọsọ ọdụ njikọ tupu egbochie mmụba ngụkọ na mberede."

#: lib/Settings.php
msgid "Security, ERP Webhooks, and Retention"
msgstr "Nchekwa, Webhook ERP, na Nchekwa Oge"

#: lib/Settings.php
msgid "Outbound Webhook Timeout (seconds)"
msgstr "Oge Njedebe Webhook Na-apụ Apụ (sekọnd)"

#: lib/Settings.php
msgid "Bounded HTTPS timeout for ERP billing connector deliveries (1 to 60s)."
msgstr "Oge njedebe HTTPS nwere oke maka nnyefe njikọ ịgba ụgwọ ERP (1 ruo 60s)."

#: lib/Settings.php
msgid "Maximum Webhook Response Bytes"
msgstr "Bayịtị Nzaghachi Webhook Kasị Elu"

#: lib/Settings.php
msgid "Upper bound on bytes read from ERP webhook responses."
msgstr "Oke kasị elu nke bayịtị agụrụ site na nzaghachi webhook ERP."

#: lib/Settings.php
msgid "AES-256-GCM External Keyfile Path"
msgstr "Ụzọ Faịlụ Igodo Mpụga AES-256-GCM"

#: lib/Settings.php
msgid "Absolute filesystem path to the external 256-bit keyfile protecting ERP connector secrets."
msgstr "Ụzọ zuru oke na sistemụ faịlụ ruo na faịlụ igodo mpụga 256-bit nke na-echebe nzuzo njikọ ERP."

#: lib/Settings.php
msgid "Burst Budget Warning Threshold (%)"
msgstr "Oke Ịdọ Aka ná Ntị nke Mmefu Ego Mmụba (%)"

#: lib/Settings.php
msgid "Percentage of monthly burst slots consumed before raising a warning forecast."
msgstr "Pasentị nke oghere mmụba kwa ọnwa ejirila tupu ewepụta amụma ịdọ aka ná ntị."

#: lib/Settings.php
msgid "Burst Budget Critical Threshold (%)"
msgstr "Oke Dị Egwu nke Mmefu Ego Mmụba (%)"

#: lib/Settings.php
msgid "Percentage of monthly burst slots consumed before raising a critical forecast."
msgstr "Pasentị nke oghere mmụba kwa ọnwa ejirila tupu ewepụta amụma dị egwu."

#: lib/Settings.php
msgid "Preserve Ledger Tables on Uninstall"
msgstr "Chekwaa Tebụl Akwụkwọ Ego Mgbe A Na-ewepụ Ngwa Mgbakwunye"

#: lib/Settings.php
msgid "Keep plugin_billing_* tables (including immutable samples and statements) when uninstalling."
msgstr "Debe tebụl plugin_billing_* (gụnyere ihe nlele na nkwupụta ndị a na-apụghị ịgbanwe) mgbe a na-ewepụ ngwa mgbakwunye."

