#: lib/Settings.php
msgid "Rating & 95th-Percentile Defaults"
msgstr "料金計算と 95 パーセンタイルのデフォルト設定"

#: lib/Settings.php
msgid "Default Percentile"
msgstr "デフォルトのパーセンタイル"

#: lib/Settings.php
msgid "Default Nth percentile applied to new burstable contracts (50.0 to 100.0)."
msgstr "新規バースト可能契約に適用されるデフォルトの N パーセンタイルです (50.0〜100.0)。"

#: lib/Settings.php
msgid "Default Drop-Count Rounding"
msgstr "デフォルトの除外件数丸め方式"

#: lib/Settings.php
msgid "Rounding mode for peak intervals dropped when computing the Nth percentile."
msgstr "N パーセンタイル計算時に除外するピーク区間数の丸め方式です。"

#: lib/Settings.php
msgid "Floor"
msgstr "切り捨て"

#: lib/Settings.php
msgid "Ceiling"
msgstr "切り上げ"

#: lib/Settings.php
msgid "Nearest"
msgstr "四捨五入"

#: lib/Settings.php
msgid "Default Missing-Sample Policy"
msgstr "デフォルトの欠損サンプル処理ポリシー"

#: lib/Settings.php
msgid "How missing 5-minute intervals are treated during rating."
msgstr "料金計算時に欠損している 5 分間隔データの処理方法を指定します。"

#: lib/Settings.php
msgid "Exclude gaps"
msgstr "欠損区間を除外する"

#: lib/Settings.php
msgid "Zero-fill missing slots"
msgstr "欠損スロットをゼロ埋めする"

#: lib/Settings.php
msgid "Carry forward previous sample"
msgstr "直前のサンプル値を引き継ぐ"

#: lib/Settings.php
msgid "Default ISO 4217 Currency"
msgstr "デフォルトの ISO 4217 通貨"

#: lib/Settings.php
msgid "Three-letter uppercase ISO 4217 currency code for new accounts and contracts."
msgstr "新規アカウントおよび契約に使用する 3 文字の大文字 ISO 4217 通貨コードです。"

#: lib/Settings.php
msgid "Counter Spike Cap Multiplier"
msgstr "カウンタースパイク上限倍率"

#: lib/Settings.php
msgid "Maximum bps multiple of interface port speed before clamping counter spikes."
msgstr "カウンタースパイクを制限する前のインターフェースポート速度に対する最大 bps 倍率です。"

#: lib/Settings.php
msgid "Security, ERP Webhooks, and Retention"
msgstr "セキュリティ、ERP Webhook、およびデータ保持"

#: lib/Settings.php
msgid "Outbound Webhook Timeout (seconds)"
msgstr "送信 Webhook タイムアウト (秒)"

#: lib/Settings.php
msgid "Bounded HTTPS timeout for ERP billing connector deliveries (1 to 60s)."
msgstr "ERP 課金コネクター配信時の HTTPS タイムアウト上限です (1〜60 秒)。"

#: lib/Settings.php
msgid "Maximum Webhook Response Bytes"
msgstr "最大 Webhook レスポンスバイト数"

#: lib/Settings.php
msgid "Upper bound on bytes read from ERP webhook responses."
msgstr "ERP Webhook レスポンスから読み取るバイト数の上限です。"

#: lib/Settings.php
msgid "AES-256-GCM External Keyfile Path"
msgstr "AES-256-GCM 外部鍵ファイルパス"

#: lib/Settings.php
msgid "Absolute filesystem path to the external 256-bit keyfile protecting ERP connector secrets."
msgstr "ERP コネクターのシークレットを保護する外部 256 ビット鍵ファイルの絶対ファイルシステムパスです。"

#: lib/Settings.php
msgid "Burst Budget Warning Threshold (%)"
msgstr "バースト予算の警告しきい値 (%)"

#: lib/Settings.php
msgid "Percentage of monthly burst slots consumed before raising a warning forecast."
msgstr "警告予測を発生させる月間バーストスロット消費率 (%) です。"

#: lib/Settings.php
msgid "Burst Budget Critical Threshold (%)"
msgstr "バースト予算の危険しきい値 (%)"

#: lib/Settings.php
msgid "Percentage of monthly burst slots consumed before raising a critical forecast."
msgstr "危険予測を発生させる月間バーストスロット消費率 (%) です。"

#: lib/Settings.php
msgid "Preserve Ledger Tables on Uninstall"
msgstr "アンインストール時に台帳テーブルを保持する"

#: lib/Settings.php
msgid "Keep plugin_billing_* tables (including immutable samples and statements) when uninstalling."
msgstr "アンインストール時に plugin_billing_* テーブル (不変のサンプルおよび明細書を含む) を保持します。"

