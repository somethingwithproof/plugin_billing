msgid "Utilities"
msgstr "Kayan Aiki"

#: setup.php
msgid "Billing"
msgstr "Lissafin Kuɗi"

#: setup.php
msgid "Burstable Transit & Usage Billing"
msgstr "Lissafin Kuɗin Hanyar Sadarwa Mai Iya Ƙaruwa da Amfani"

