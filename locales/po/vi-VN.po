msgstr "Tài khoản tính cước & Biểu giá"

#: lib/Settings.php
msgid "Rating & 95th-Percentile Defaults"
msgstr "Mặc định định giá & Phân vị thứ 95"

#: lib/Settings.php
msgid "Default Percentile"
msgstr "Phân vị mặc định"

#: lib/Settings.php
msgid "Default Nth percentile applied to new burstable contracts (50.0 to 100.0)."
msgstr "Phân vị thứ N mặc định áp dụng cho các hợp đồng vượt ngưỡng mới (50.0 đến 100.0)."

#: lib/Settings.php
msgid "Default Drop-Count Rounding"
msgstr "Làm tròn số mẫu loại bỏ mặc định"

#: lib/Settings.php
msgid "Rounding mode for peak intervals dropped when computing the Nth percentile."
msgstr "Chế độ làm tròn cho số khoảng thời gian đỉnh bị loại bỏ khi tính phân vị thứ N."

#: lib/Settings.php
msgid "Floor"
msgstr "Làm tròn xuống"

#: lib/Settings.php
msgid "Ceiling"
msgstr "Làm tròn lên"

#: lib/Settings.php
msgid "Nearest"
msgstr "Gần nhất"

#: lib/Settings.php
msgid "Default Missing-Sample Policy"
msgstr "Chính sách xử lý mẫu bị thiếu mặc định"

#: lib/Settings.php
msgid "How missing 5-minute intervals are treated during rating."
msgstr "Cách xử lý các khoảng 5 phút bị thiếu dữ liệu trong quá trình tính cước."

#: lib/Settings.php
msgid "Exclude gaps"
msgstr "Loại trừ khoảng trống"

#: lib/Settings.php
msgid "Zero-fill missing slots"
msgstr "Điền giá trị 0 cho các khe bị thiếu"

#: lib/Settings.php
msgid "Carry forward previous sample"
msgstr "Dùng tiếp giá trị mẫu trước đó"

#: lib/Settings.php
msgid "Default ISO 4217 Currency"
msgstr "Đơn vị tiền tệ ISO 4217 mặc định"

#: lib/Settings.php
msgid "Three-letter uppercase ISO 4217 currency code for new accounts and contracts."
msgstr "Mã tiền tệ ISO 4217 gồm ba chữ cái viết hoa cho tài khoản và hợp đồng mới."

#: lib/Settings.php
msgid "Counter Spike Cap Multiplier"
msgstr "Hệ số giới hạn đột biến bộ đếm"

#: lib/Settings.php
msgid "Maximum bps multiple of interface port speed before clamping counter spikes."
msgstr "Bội số bps tối đa so với tốc độ cổng giao diện trước khi cắt giới hạn đột biến bộ đếm."

#: lib/Settings.php
msgid "Security, ERP Webhooks, and Retention"
msgstr "Bảo mật, Webhook ERP và Lưu giữ dữ liệu"

#: lib/Settings.php
msgid "Outbound Webhook Timeout (seconds)"
msgstr "Thời gian chờ webhook gửi đi (giây)"

#: lib/Settings.php
msgid "Bounded HTTPS timeout for ERP billing connector deliveries (1 to 60s)."
msgstr "Thời gian chờ HTTPS giới hạn cho các lần gửi của trình kết nối tính cước ERP (1 đến 60 giây)."

#: lib/Settings.php
msgid "Maximum Webhook Response Bytes"
msgstr "Số byte phản hồi webhook tối đa"

#: lib/Settings.php
msgid "Upper bound on bytes read from ERP webhook responses."
msgstr "Giới hạn trên về số byte đọc từ phản hồi webhook ERP."

#: lib/Settings.php
msgid "AES-256-GCM External Keyfile Path"
msgstr "Đường dẫn tệp khóa ngoài AES-256-GCM"

#: lib/Settings.php
msgid "Absolute filesystem path to the external 256-bit keyfile protecting ERP connector secrets."
msgstr "Đường dẫn hệ thống tệp tuyệt đối tới tệp khóa 256-bit bên ngoài bảo vệ bí mật của trình kết nối ERP."

#: lib/Settings.php
msgid "Burst Budget Warning Threshold (%)"
msgstr "Ngưỡng cảnh báo hạn mức vượt ngưỡng (%)"

#: lib/Settings.php
msgid "Percentage of monthly burst slots consumed before raising a warning forecast."
msgstr "Tỷ lệ phần trăm khe vượt ngưỡng hằng tháng đã tiêu thụ trước khi phát cảnh báo dự báo."

#: lib/Settings.php
msgid "Burst Budget Critical Threshold (%)"
msgstr "Ngưỡng nghiêm trọng hạn mức vượt ngưỡng (%)"

#: lib/Settings.php
msgid "Percentage of monthly burst slots consumed before raising a critical forecast."
msgstr "Tỷ lệ phần trăm khe vượt ngưỡng hằng tháng đã tiêu thụ trước khi phát dự báo mức nghiêm trọng."

#: lib/Settings.php
msgid "Preserve Ledger Tables on Uninstall"
msgstr "Giữ nguyên bảng sổ cái khi gỡ cài đặt"

#: lib/Settings.php
msgid "Keep plugin_billing_* tables (including immutable samples and statements) when uninstalling."
msgstr "Giữ lại các bảng plugin_billing_* (bao gồm mẫu và bảng kê bất biến) khi gỡ cài đặt."

