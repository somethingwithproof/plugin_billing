msgstr "Ukubuka Ukukhokhisa"

#: lib/Pages.php
msgid "Billing Operator"
msgstr "Umqhubi Wokukhokhisa"

#: lib/Pages.php
msgid "Billing Admin"
msgstr "Umlawuli Wokukhokhisa"

#: lib/Pages.php
msgid "Billing Usage & Forecasts"
msgstr "Ukusetshenziswa Kokukhokhisa Nezibikezelo"

#: lib/Pages.php
