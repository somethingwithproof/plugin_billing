#: lib/Settings.php
msgid "Default Percentile"
msgstr "Domyślny percentyl"

#: lib/Settings.php
msgid "Default Nth percentile applied to new burstable contracts (50.0 to 100.0)."
msgstr "Domyślny N-ty percentyl stosowany dla nowych umów z pasmem zmiennym (od 50.0 do 100.0)."

#: lib/Settings.php
msgid "Default Drop-Count Rounding"
msgstr "Domyślne zaokrąglanie liczby odrzucanych próbek"

#: lib/Settings.php
msgid "Rounding mode for peak intervals dropped when computing the Nth percentile."
msgstr "Tryb zaokrąglania liczby szczytowych przedziałów odrzucanych podczas obliczania N-tego percentyla."

#: lib/Settings.php
msgid "Floor"
msgstr "W dół"

#: lib/Settings.php
msgid "Ceiling"
msgstr "W górę"

#: lib/Settings.php
msgid "Nearest"
msgstr "Do najbliższej"

#: lib/Settings.php
msgid "Default Missing-Sample Policy"
msgstr "Domyślna polityka brakujących próbek"

#: lib/Settings.php
msgid "How missing 5-minute intervals are treated during rating."
msgstr "Sposób traktowania brakujących 5-minutowych przedziałów podczas taryfikacji."

#: lib/Settings.php
msgid "Exclude gaps"
msgstr "Wyklucz luki"

#: lib/Settings.php
msgid "Zero-fill missing slots"
msgstr "Wypełnij brakujące przedziały zerami"

#: lib/Settings.php
msgid "Carry forward previous sample"
msgstr "Przenieś poprzednią próbkę"

#: lib/Settings.php
msgid "Default ISO 4217 Currency"
msgstr "Domyślna waluta ISO 4217"

#: lib/Settings.php
msgid "Three-letter uppercase ISO 4217 currency code for new accounts and contracts."
msgstr "Trzyliterowy kod waluty ISO 4217 pisany wielkimi literami dla nowych kont i umów."

#: lib/Settings.php
msgid "Counter Spike Cap Multiplier"
msgstr "Mnożnik limitu skoków licznika"

#: lib/Settings.php
msgid "Maximum bps multiple of interface port speed before clamping counter spikes."
msgstr "Maksymalna wielokrotność prędkości portu interfejsu w bps przed obcięciem skoków licznika."

#: lib/Settings.php
msgid "Security, ERP Webhooks, and Retention"
msgstr "Bezpieczeństwo, webhooki ERP i retencja danych"

#: lib/Settings.php
msgid "Outbound Webhook Timeout (seconds)"
msgstr "Limit czasu wychodzących webhooków (sekundy)"

#: lib/Settings.php
msgid "Bounded HTTPS timeout for ERP billing connector deliveries (1 to 60s)."
msgstr "Ograniczony limit czasu HTTPS dla dostarczania danych przez łączniki rozliczeniowe ERP (od 1 do 60 s)."

#: lib/Settings.php
msgid "Maximum Webhook Response Bytes"
msgstr "Maksymalny rozmiar odpowiedzi webhooka (bajty)"

#: lib/Settings.php
msgid "Upper bound on bytes read from ERP webhook responses."
msgstr "Górny limit liczby bajtów odczytywanych z odpowiedzi webhooków ERP."

#: lib/Settings.php
msgid "AES-256-GCM External Keyfile Path"
msgstr "Ścieżka zewnętrznego pliku klucza AES-256-GCM"

#: lib/Settings.php
msgid "Absolute filesystem path to the external 256-bit keyfile protecting ERP connector secrets."
msgstr "Bezwzględna ścieżka w systemie plików do zewnętrznego 256-bitowego pliku klucza chroniącego sekrety łączników ERP."

#: lib/Settings.php
msgid "Burst Budget Warning Threshold (%)"
msgstr "Próg ostrzegawczy budżetu szczytowego (%)"

#: lib/Settings.php
msgid "Percentage of monthly burst slots consumed before raising a warning forecast."
msgstr "Procent wykorzystanych miesięcznych przedziałów szczytowych przed wygenerowaniem prognozy ostrzegawczej."

#: lib/Settings.php
msgid "Burst Budget Critical Threshold (%)"
msgstr "Próg krytyczny budżetu szczytowego (%)"

#: lib/Settings.php
msgid "Percentage of monthly burst slots consumed before raising a critical forecast."
msgstr "Procent wykorzystanych miesięcznych przedziałów szczytowych przed wygenerowaniem prognozy krytycznej."

#: lib/Settings.php
msgid "Preserve Ledger Tables on Uninstall"
msgstr "Zachowaj tabele rejestru rozliczeń przy odinstalowaniu"

#: lib/Settings.php
msgid "Keep plugin_billing_* tables (including immutable samples and statements) when uninstalling."
msgstr "Zachowaj tabele plugin_billing_* (w tym niezmienne próbki i zestawienia) podczas odinstalowywania."

