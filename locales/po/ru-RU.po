msgstr "Аудит биллинговых выписок, проверка подлинности и экспорт (оператор)"

#: billing_view.php
msgid "Billing Usage & Mid-Cycle Burst Forecasts"
msgstr "Потребление по биллингу и прогнозы всплесков в середине периода"

#: lib/Pages.php
msgid "Billing View"
msgstr "Просмотр биллинга"

#: lib/Pages.php
msgid "Billing Operator"
msgstr "Оператор биллинга"

#: lib/Pages.php
msgid "Billing Admin"
msgstr "Администратор биллинга"

#: lib/Pages.php
msgid "Billing Usage & Forecasts"
msgstr "Потребление и прогнозы биллинга"

#: lib/Pages.php
msgid "Billing Statements & Audit"
msgstr "Выписки и аудит биллинга"

#: lib/Pages.php
msgid "Billing Accounts & Tariffs"
msgstr "Учетные записи и тарифы биллинга"

#: lib/Settings.php
msgid "Rating & 95th-Percentile Defaults"
msgstr "Параметры тарификации и 95-го перцентиля по умолчанию"

#: lib/Settings.php
msgid "Default Percentile"
msgstr "Перцентиль по умолчанию"

#: lib/Settings.php
msgid "Default Nth percentile applied to new burstable contracts (50.0 to 100.0)."
msgstr "N-й перцентиль по умолчанию для новых договоров с возможностью превышения полосы (от 50.0 до 100.0)."

#: lib/Settings.php
msgid "Default Drop-Count Rounding"
msgstr "Округление числа отбрасываемых интервалов по умолчанию"

#: lib/Settings.php
msgid "Rounding mode for peak intervals dropped when computing the Nth percentile."
msgstr "Режим округления числа пиковых интервалов, отбрасываемых при расчете N-го перцентиля."

#: lib/Settings.php
msgid "Floor"
msgstr "Вниз (к меньшему)"

#: lib/Settings.php
msgid "Ceiling"
msgstr "Вверх (к большему)"

#: lib/Settings.php
msgid "Nearest"
msgstr "К ближайшему"

#: lib/Settings.php
msgid "Default Missing-Sample Policy"
msgstr "Политика обработки пропущенных выборок по умолчанию"

#: lib/Settings.php
msgid "How missing 5-minute intervals are treated during rating."
msgstr "Способ обработки отсутствующих 5-минутных интервалов при тарификации."

#: lib/Settings.php
msgid "Exclude gaps"
msgstr "Исключать пропуски"

#: lib/Settings.php
msgid "Zero-fill missing slots"
msgstr "Заполнять пропущенные интервалы нулями"

#: lib/Settings.php
msgid "Carry forward previous sample"
msgstr "Переносить предыдущую выборку"

#: lib/Settings.php
msgid "Default ISO 4217 Currency"
msgstr "Валюта ISO 4217 по умолчанию"

#: lib/Settings.php
msgid "Three-letter uppercase ISO 4217 currency code for new accounts and contracts."
msgstr "Трехбуквенный код валюты ISO 4217 в верхнем регистре для новых учетных записей и договоров."

#: lib/Settings.php
msgid "Counter Spike Cap Multiplier"
msgstr "Множитель ограничения всплесков счетчика"

#: lib/Settings.php
msgid "Maximum bps multiple of interface port speed before clamping counter spikes."
msgstr "Максимальная кратность скорости порта интерфейса в bps перед ограничением всплесков счетчика."

#: lib/Settings.php
msgid "Security, ERP Webhooks, and Retention"
msgstr "Безопасность, вебхуки ERP и хранение данных"

#: lib/Settings.php
msgid "Outbound Webhook Timeout (seconds)"
msgstr "Тайм-аут исходящих вебхуков (секунды)"

#: lib/Settings.php
msgid "Bounded HTTPS timeout for ERP billing connector deliveries (1 to 60s)."
msgstr "Ограниченный тайм-аут HTTPS для доставки данных коннекторами биллинга ERP (от 1 до 60 с)."

#: lib/Settings.php
msgid "Maximum Webhook Response Bytes"
msgstr "Максимальный размер ответа вебхука (байты)"

#: lib/Settings.php
msgid "Upper bound on bytes read from ERP webhook responses."
msgstr "Верхний предел числа байтов, считываемых из ответов вебхуков ERP."

#: lib/Settings.php
msgid "AES-256-GCM External Keyfile Path"
msgstr "Путь к внешнему файлу ключа AES-256-GCM"

#: lib/Settings.php
msgid "Absolute filesystem path to the external 256-bit keyfile protecting ERP connector secrets."
msgstr "Абсолютный путь в файловой системе к внешнему 256-битному файлу ключа для защиты секретов коннекторов ERP."

#: lib/Settings.php
msgid "Burst Budget Warning Threshold (%)"
msgstr "Порог предупреждения бюджета всплесков (%)"

#: lib/Settings.php
msgid "Percentage of monthly burst slots consumed before raising a warning forecast."
msgstr "Доля использованных месячных интервалов всплеска в процентах для выдачи предупреждения в прогнозе."

#: lib/Settings.php
msgid "Burst Budget Critical Threshold (%)"
msgstr "Критический порог бюджета всплесков (%)"

#: lib/Settings.php
msgid "Percentage of monthly burst slots consumed before raising a critical forecast."
msgstr "Доля использованных месячных интервалов всплеска в процентах для выдачи критического прогноза."

#: lib/Settings.php
msgid "Preserve Ledger Tables on Uninstall"
msgstr "Сохранять таблицы учета при удалении"

#: lib/Settings.php
msgid "Keep plugin_billing_* tables (including immutable samples and statements) when uninstalling."
msgstr "Сохранять таблицы plugin_billing_* (включая неизменяемые выборки и выписки) при удалении плагина."

